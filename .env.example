# Copiez ce fichier en `.env` pour le local, et recopiez les mêmes variables
# dans Vercel (Project → Settings → Environment Variables).
# NE COMMITEZ JAMAIS le fichier `.env`.

# URL publique du site (liens dans les e-mails, balises SEO)
SITE_URL=https://www.votre-domaine.com

# --- Resend (e-mails) ---------------------------------------------------
# https://resend.com → API Keys. Le domaine d'envoi doit être vérifié.
RESEND_API_KEY=
# Expéditeur affiché, ex: "Binta Kande <hello@votre-domaine.com>"
MAIL_FROM=
# Votre adresse : reçoit les récapitulatifs, messages et inscriptions
OWNER_EMAIL=

# --- Google Agenda (OAuth) ----------------------------------------------
# Voir le README, section « Brancher Google Agenda ».
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# "primary" = votre agenda principal. Sinon l'ID d'un agenda précis.
GOOGLE_CALENDAR_ID=primary

# --- Assistant du site (chatbot) ----------------------------------------
# Clé de l'API Claude : https://console.anthropic.com → API Keys.
# Laissée vide, l'assistant répond en « mode aperçu » avec des réponses simples.
ANTHROPIC_API_KEY=
# Optionnel : modèle utilisé (par défaut claude-haiku-5-5, rapide et économique)
CHAT_MODEL=

# --- Stripe (paiements) -------------------------------------------------
# Clé RESTREINTE (Developers → API keys → Create restricted key) : droit
# d'écriture sur « Checkout Sessions », lecture sur PaymentIntents/Charges.
STRIPE_SECRET_KEY=
# Secret du webhook https://VOTRE-DOMAINE/api/stripe-webhook (commence par whsec_)
STRIPE_WEBHOOK_SECRET=
# Identifiants de prix (price_...) des deux produits
STRIPE_PRICE_DIAGNOSTIC=
STRIPE_PRICE_PROMPT=
# Active le bouton d'achat sur le site (variable lue au build). Sinon « Bientôt disponible ».
PUBLIC_CHECKOUT=

# --- Base de données et tableau de bord ---------------------------------
# URL interne de la base PostgreSQL de Coolify
DATABASE_URL=
# Mot de passe de /admin (12 caractères minimum)
ADMIN_PASSWORD=

# --- Tableau de bord : état des automatisations n8n ---------------------
# Adresse de votre n8n, ex: https://n8n.bintakande.com
N8N_URL=
# Clé API n8n (Settings > n8n API)
N8N_API_KEY=

# --- Umami (visites), variables lues au build ---------------------------
PUBLIC_UMAMI_URL=
PUBLIC_UMAMI_ID=

# --- Agent IA (n8n) -----------------------------------------------------
# URL de production du webhook n8n, ex: https://n8n.votre-domaine.com/webhook/diagnostic
N8N_WEBHOOK_URL=
# Même valeur que le secret de l'identifiant « Header Auth » créé dans n8n
N8N_WEBHOOK_SECRET=
