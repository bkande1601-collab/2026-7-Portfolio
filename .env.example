# Copiez ce fichier en `.env` pour le local, et recopiez les mêmes variables
# dans Vercel (Project → Settings → Environment Variables).
# NE COMMITEZ JAMAIS le fichier `.env`.

# URL publique du site (liens dans les e-mails, balises SEO)
SITE_URL=https://www.votre-domaine.com

# --- Resend (e-mails) ---------------------------------------------------
# https://resend.com → API Keys. Le domaine d'envoi doit être vérifié.
RESEND_API_KEY=
# Expéditeur affiché, ex: "Binta Kande <hello@votre-domaine.com>"
MAIL_FROM=
# Votre adresse : reçoit les récapitulatifs, messages et inscriptions
OWNER_EMAIL=

# --- Google Agenda (OAuth) ----------------------------------------------
# Voir le README, section « Brancher Google Agenda ».
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# "primary" = votre agenda principal. Sinon l'ID d'un agenda précis.
GOOGLE_CALENDAR_ID=primary
