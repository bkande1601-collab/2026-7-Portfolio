---
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource-variable/archivo/wdth-italic.css';
import '../styles/global.css';
import { t, href, type Lang } from '../content';
import { site } from '../config/site';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ChatWidget from '../components/ChatWidget.astro';
import StickyBuyBar from '../components/StickyBuyBar.astro';

interface Props {
  lang: Lang;
  /** slug de la page ('' = accueil), sert au sélecteur de langue et au SEO */
  page?: string;
  title?: string;
  description?: string;
  noindex?: boolean;
  /** barre fixe « diagnostic / prompt » en bas de page (pages de services) */
  buybar?: boolean;
  /** sur la page d'un produit : n'affiche que ce produit dans la barre */
  buybarOnly?: 'diagnostic' | 'prompt';
  /** image de partage (chemin ou URL absolue), 1200 x 630 */
  ogImage?: string;
  ogType?: 'website' | 'article';
  published?: string;
  modified?: string;
  /** titre complet de la balise <title> (sans le nom du site ajouté automatiquement) */
  rawTitle?: string;
  /** données structurées (JSON-LD) propres à la page */
  jsonLd?: object[];
}
const { lang, page = '', title, description, noindex = false, buybar = false, buybarOnly, ogImage, ogType = 'website', published, modified, rawTitle, jsonLd = [] } = Astro.props;
const umamiUrl = (import.meta.env.PUBLIC_UMAMI_URL ?? '').replace(/\/$/, '');
const umamiId = import.meta.env.PUBLIC_UMAMI_ID ?? '';
const c = t(lang);
const other: Lang = lang === 'fr' ? 'en' : 'fr';
const pageTitle = rawTitle ?? (title ? `${title} | ${site.name}` : c.meta.title);
const pageDesc = description ?? c.meta.description;
const origin = Astro.site ? Astro.site.origin : '';
const pageUrl = `${origin}${href(lang, page)}`;
const img = (ogImage ?? '/og/default.png').startsWith('http') ? (ogImage as string) : `${origin}${ogImage ?? '/og/default.png'}`;
const org = { '@context': 'https://schema.org', '@type': 'Organization', name: site.name, url: origin, logo: `${origin}/apple-touch-icon.png`, email: 'hello@bintakande.com' };
---

<!doctype html>
<html lang={c.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDesc} />
    <meta name="theme-color" content="#f6f0e4" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" hreflang="fr" href={`${origin}${href('fr', page)}`} />
    <link rel="alternate" hreflang="en" href={`${origin}${href('en', page)}`} />
    <link rel="canonical" href={`${origin}${href(lang, page)}`} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:locale" content={c.locale} />
    <meta property="og:locale:alternate" content={t(other).locale} />
    <meta property="og:image" content={img} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDesc} />
    <meta name="twitter:image" content={img} />
    {ogType === 'article' && published && <meta property="article:published_time" content={published} />}
    {ogType === 'article' && (modified ?? published) && <meta property="article:modified_time" content={modified ?? published} />}
    {ogType === 'article' && <meta property="article:author" content={site.name} />}
    {noindex ? <meta name="robots" content="noindex, nofollow" /> : <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />}
    <script type="application/ld+json" set:html={JSON.stringify(org)} />
    {jsonLd.map((j) => <script type="application/ld+json" set:html={JSON.stringify(j)} />)}
    {umamiUrl && umamiId && <script defer src={`${umamiUrl}/script.js`} data-website-id={umamiId}></script>}
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <a class="skip" href="#main">{c.nav.skip}</a>
    <Header lang={lang} page={page} otherHref={href(other, page)} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
    {buybar && <StickyBuyBar lang={lang} only={buybarOnly} />}
    <ChatWidget lang={lang} />

    <script>
      // apparition douce au scroll
      const items = document.querySelectorAll('.reveal, .lab-items');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add('in');
                io.unobserve(e.target);
              }
            });
          },
          { threshold: 0.12, rootMargin: '0px 0px -40px 0px' },
        );
        items.forEach((el) => io.observe(el));
      } else {
        items.forEach((el) => el.classList.add('in'));
      }

      // suivi : les liens vers « réserver » et « message » gardent la page d'origine
      const here = location.pathname.replace(/^\/(fr|en)\/?/, '').replace(/\.html$/, '');
      document.querySelectorAll<HTMLAnchorElement>('a[href]').forEach((a) => {
        const u = new URL(a.getAttribute('href') || '', location.origin);
        if (u.origin === location.origin && /^\/(fr|en)\/(book|contact)$/.test(u.pathname) && here && !/^(book|contact)$/.test(here) && !u.searchParams.has('from')) {
          u.searchParams.set('from', here);
          a.setAttribute('href', u.pathname + u.search);
        }
      });

      // bouton d'action unique : il ouvre le choix « audit » ou « message »
      const ctas = document.querySelectorAll<HTMLElement>('.cta-menu');
      const closeCtas = (except?: HTMLElement) =>
        ctas.forEach((m) => {
          if (m !== except) {
            m.classList.remove('open');
            m.querySelector('.cta-main')?.setAttribute('aria-expanded', 'false');
          }
        });
      ctas.forEach((m) => {
        const b = m.querySelector<HTMLButtonElement>('.cta-main');
        b?.addEventListener('click', (e) => {
          e.stopPropagation();
          const open = !m.classList.contains('open');
          closeCtas(m);
          m.classList.toggle('open', open);
          b.setAttribute('aria-expanded', String(open));
        });
      });
      document.addEventListener('click', () => closeCtas());
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeCtas();
      });

      // sous-menus : un bouton ▾ pour le clavier et le tactile
      const subItems = document.querySelectorAll<HTMLElement>('.nav-item.has-sub');
      const closeAll = (except?: HTMLElement) =>
        subItems.forEach((it) => {
          if (it !== except) {
            it.dataset.open = 'false';
            it.querySelector('.sub-toggle')?.setAttribute('aria-expanded', 'false');
          }
        });
      subItems.forEach((it) => {
        const b = it.querySelector<HTMLButtonElement>('.sub-toggle');
        b?.addEventListener('click', (e) => {
          e.stopPropagation();
          const open = it.dataset.open !== 'true';
          closeAll(it);
          it.dataset.open = String(open);
          b.setAttribute('aria-expanded', String(open));
        });
      });
      document.addEventListener('click', () => closeAll());
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeAll();
      });

      // menu mobile
      const btn = document.getElementById('menu-btn');
      const nav = document.getElementById('site-nav');
      if (btn && nav) {
        const set = (open: boolean) => {
          nav.dataset.open = String(open);
          btn.setAttribute('aria-expanded', String(open));
        };
        btn.addEventListener('click', () => set(nav.dataset.open !== 'true'));
        nav.addEventListener('click', (e) => {
          if ((e.target as HTMLElement).closest('a')) set(false);
        });
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') set(false);
        });
      }
    </script>
  </body>
</html>
