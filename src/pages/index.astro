---
// La racine redirige côté serveur vers /en si la langue préférée du navigateur est l'anglais, sinon vers /fr.
// Les robots (sans préférence de langue) vont donc sur la version française, qui est la page de référence.
export const prerender = false;
const al = Astro.request.headers.get('accept-language') ?? '';
const lang = /^\s*en\b/i.test(al) ? 'en' : 'fr';
Astro.response.headers.set('Vary', 'Accept-Language');
Astro.response.headers.set('Cache-Control', 'no-store');
return Astro.redirect(`/${lang}`, 302);
---
