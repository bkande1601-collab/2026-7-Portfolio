---
import Base from '../../layouts/Base.astro';
import Marquee from '../../components/Marquee.astro';
import CtaBand from '../../components/CtaBand.astro';
import { t, em, langs, type Lang } from '../../content';
import { site } from '../../config/site';

export function getStaticPaths() {
  return langs.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const c = t(lang);
const j = c.journey;
---

<Base lang={lang} page="journey" title={c.nav.journey} description={j.hero.sub}>
  <section class="page-hero">
    <div class="wrap">
      <span class="kicker">{j.hero.kicker}</span>
      <h1 set:html={em(j.hero.title)} />
      <p class="lead">{j.hero.sub}</p>
    </div>
  </section>

  <section style="padding-top:clamp(24px,4vw,48px)">
    <div class="wrap journey">
      <!-- Photo : voir `photo` dans src/config/site.ts -->
      <div class="photo reveal">
        {
          site.photo ? (
            <img src={site.photo} alt={j.photoAlt} width="640" height="800" loading="lazy" />
          ) : (
            <span>{j.photoNote}</span>
          )
        }
      </div>
      <ol class="timeline">
        {
          j.items.map((it) => (
            <li class={`reveal${it.todo ? ' todo' : ''}`}>
              <span class="when">{it.when}</span>
              <h3>
                {it.title}
                {it.org && <>, <span class="org">{it.org}</span></>}
                {it.todo && <span class="todo-tag">{j.todo}</span>}
              </h3>
              <p>{it.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
    <div class="wrap">
      <p class="languages reveal">{j.languages}</p>
    </div>
  </section>

  <section id="hackathon" class="band-lilas" style="padding-bottom:clamp(48px,7vw,96px)">
    <div class="wrap">
      <div class="proof-feature reveal">
        <div class="proof-photos">
          <img src="/photos/hackathon-mirakl-eugenia.webp" alt={j.hackathon.alt} width="1179" height="628" loading="lazy" />
          <img class="proof-pitch" src="/photos/pitch.webp" alt={j.hackathon.pitchAlt} width="855" height="1000" loading="lazy" />
        </div>
        <div>
          <span class="formula-tag">{j.hackathon.tag}</span>
          <h3>{j.hackathon.title}</h3>
          <p class="lead">{j.hackathon.text}</p>
          {
            site.hackathonLink && (
              <p style="margin-top:22px">
                <a class="textlink" href={site.hackathonLink} rel="noopener noreferrer" target="_blank">
                  <span class="arrow">{j.hackathon.link}&nbsp;</span>
                </a>
              </p>
            )
          }
        </div>
      </div>
    </div>
  </section>

  <Marquee label={j.stackTitle} />
  <CtaBand lang={lang} title={c.home.finalTitle} text={c.home.finalText} />
</Base>
