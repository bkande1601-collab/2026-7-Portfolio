---
import Base from '../../../layouts/Base.astro';
import Window from '../../../components/Window.astro';
import CtaBand from '../../../components/CtaBand.astro';
import CtaMenu from '../../../components/CtaMenu.astro';
import Crumb from '../../../components/Crumb.astro';
import MotionVideo from '../../../components/MotionVideo.astro';
import { t, em, href, langs, type Lang } from '../../../content';
import { site } from '../../../config/site';

export function getStaticPaths() {
  return langs.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const c = t(lang);
const a = c.automations;
const video = site.agentVideo[lang];
---

<Base lang={lang} page="automations/agents" title={c.nav.sub.agents} description={a.agent.text}>
  <!-- Dès l'arrivée : la vidéo qui explique ce qu'est un agent IA -->
  <section class="video-hero">
    <div class="wrap">
      <Crumb lang={lang} parent="automations" label={c.nav.automations} />
      {
        video ? (
          <MotionVideo
            src={video}
            poster={site.agentVideoPoster[lang]}
            label={a.agent.kicker}
            soundOn={c.home.hero.soundOn}
            soundOff={c.home.hero.soundOff}
            pauseLabel={c.welcome.pause}
            playLabel={c.welcome.resume}
          />
        ) : null
      }
      <div class="video-hero-text">
        <div>
          <span class="kicker">{a.agent.kicker}</span>
          <h1 set:html={em(a.agent.title)} />
          <p class="lead">{a.agent.text}</p>
        </div>
        <CtaMenu lang={lang} />
      </div>
    </div>
  </section>

  <section>
    <div class="wrap split">
      <div class="reveal">
        <Window title={a.agent.kicker} q={a.agent.q} a={a.agent.a} src={a.agent.src} lock={c.home.platform.chat.lock} />
      </div>
      <div class="reveal">
        <span class="kicker">{a.flow.kicker}</span>
        <h2 set:html={em(a.flow.title)} />
        <p class="note">{a.flow.note}</p>
      </div>
    </div>
  </section>

  <section class="band-marine">
    <div class="wrap">
      <div class="pipeline reveal">
        {
          a.flow.steps.map((s, i) => (
            <div class="pipe-step">
              <div class="dot">{i + 1}</div>
              <b>{s.t}</b>
              <span>{s.d}</span>
            </div>
          ))
        }
      </div>
      <p class="sublinks reveal" style="margin-top:36px">
        <a class="textlink" href={href(lang, 'automations/systems')}><span class="arrow">{c.nav.sub.systems}&nbsp;</span></a>
      </p>
    </div>
  </section>

  <CtaBand lang={lang} title={a.finalTitle} text={a.finalText} />
</Base>
