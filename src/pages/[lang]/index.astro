---
import Base from '../../layouts/Base.astro';
import HeroVisual from '../../components/HeroVisual.astro';
import SkillsBar from '../../components/SkillsBar.astro';
import Marquee from '../../components/Marquee.astro';
import OfferRail from '../../components/OfferRail.astro';
import LabSection from '../../components/LabSection.astro';
import CtaBand from '../../components/CtaBand.astro';
import { t, em, href, langs, type Lang } from '../../content';
import { site, formatPrice, type PriceKey } from '../../config/site';

export function getStaticPaths() {
  return langs.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const c = t(lang);
const h = c.home;
---

<Base lang={lang} page="">
  <!-- 1. Accroche + photo (ou vidéo) -->
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <span class="kicker">{h.hero.eyebrow}</span>
        <h1 set:html={em(h.hero.title)} />
        <p class="lead">{h.hero.sub}</p>
        <div class="btn-row">
          <a class="btn btn-primary" href={href(lang, 'book')}>{c.cta.book}</a>
          <a class="btn btn-ghost" href={href(lang, 'contact')}>{c.cta.message}</a>
        </div>
        <p class="credential">{h.hero.credential}</p>
      </div>
      <HeroVisual label={h.hero.videoLabel} pending={h.hero.videoPending} soundOn={h.hero.soundOn} soundOff={h.hero.soundOff} />
    </div>
  </section>

  <!-- 2. Bande défilante des compétences -->
  <SkillsBar skills={h.skills} label={h.hero.eyebrow} />

  <!-- 3. Que cherchez-vous ? Trois portes d'entrée -->
  <section>
    <div class="wrap">
      <div class="section-head reveal">
        <span class="kicker">{h.paths.kicker}</span>
        <h2 set:html={em(h.paths.title)} />
      </div>
      <ul class="paths">
        {
          h.paths.items.map((it, i) => {
            const p = formatPrice(it.price as PriceKey, lang);
            return (
              <li class="reveal">
                <a class="path" href={href(lang, it.slug)}>
                  <span class="path-n">0{i + 1}</span>
                  <span class="path-body">
                    <span class="path-name">{it.name}</span>
                    <span class="path-line">{it.line}</span>
                  </span>
                  <span class="path-price">
                    <small>{h.paths.from}</small>
                    {p.n} €{p.per === 'month' && <small>{c.offers.perMonth}</small>}
                  </span>
                  <span class="path-go" aria-hidden="true">→</span>
                </a>
              </li>
            );
          })
        }
      </ul>
    </div>
  </section>

  <!-- 4. Comment ça se passe -->
  <section class="band-marine">
    <div class="wrap">
      <div class="section-head reveal">
        <span class="kicker">{h.how.kicker}</span>
        <h2>{h.how.title}</h2>
      </div>
      <div class="steps-line three reveal">
        {h.how.steps.map((s) => <div><b>{s.t}</b><span>{s.d}</span></div>)}
      </div>
    </div>
  </section>

  <!-- 5. Qui je suis -->
  <section class="band-lilas">
    <div class="wrap who">
      <div class="who-photo reveal">
        <img src="/photos/binta-contact.webp" alt={h.who.photoAlt} width="640" height="800" loading="lazy" />
      </div>
      <div class="reveal">
        <span class="kicker">{h.who.kicker}</span>
        <h2 set:html={em(h.who.title)} />
        <p class="lead">{h.who.text}</p>
        <p style="margin-top:28px">
          <a class="textlink" href={href(lang, 'journey')}><span class="arrow">{h.who.link}&nbsp;</span></a>
        </p>
      </div>
    </div>
  </section>

  <!-- 6. Offres sur une seule ligne -->
  <section style="padding-top:0">
    <div class="wrap">
      <div class="section-head reveal">
        <span class="kicker">{c.nav.offers}</span>
        <h2>{h.offersTitle}</h2>
      </div>
      <div class="reveal"><OfferRail lang={lang} /></div>
      <p class="rail-foot reveal">
        <a class="textlink" href={href(lang, 'offers')}><span class="arrow">{h.offersLink}&nbsp;</span></a>
      </p>
    </div>
  </section>

  <!-- 7. Outils -->
  <Marquee label={h.toolsTitle} />

  <!-- 8. Dans le labo -->
  <section style="background:var(--bg-2);border-block:1px solid var(--line)" id="labo">
    <div class="wrap">
      <LabSection lang={lang} />
    </div>
  </section>

  <CtaBand lang={lang} title={h.finalTitle} text={h.finalText} />
</Base>
