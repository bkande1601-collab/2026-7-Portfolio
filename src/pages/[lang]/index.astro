---
import Base from '../../layouts/Base.astro';
import CtaMenu from '../../components/CtaMenu.astro';
import HeroVisual from '../../components/HeroVisual.astro';
import SkillsBar from '../../components/SkillsBar.astro';
import Marquee from '../../components/Marquee.astro';
import LabSection from '../../components/LabSection.astro';
import CtaBand from '../../components/CtaBand.astro';
import { t, em, href, langs, type Lang } from '../../content';
import { site, videoPath } from '../../config/site';
import PostCard from '../../components/PostCard.astro';
import MotionVideo from '../../components/MotionVideo.astro';
import { posts } from '../../content/blog';

export function getStaticPaths() {
  return langs.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const c = t(lang);
const h = c.home;
---

<Base lang={lang} page="">
  <!-- 1. Accroche + photo (ou vidéo) -->
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <span class="kicker">{h.hero.eyebrow}</span>
        <h1 set:html={em(h.hero.title)} />
        <p class="lead">{h.hero.sub}</p>
        <div class="btn-row">
          <CtaMenu lang={lang} />
        </div>
        <p class="credential">{h.hero.credential}</p>
      </div>
      <HeroVisual label={h.hero.videoLabel} pending={h.hero.videoPending} soundOn={h.hero.soundOn} soundOff={h.hero.soundOff} />
    </div>
  </section>

  <!-- 2. Bande défilante des compétences -->
  <SkillsBar skills={h.skills} label={h.hero.eyebrow} />

  <!-- 3. Que cherchez-vous ? Trois portes d'entrée -->
  <section>
    <div class="wrap">
      <div class="section-head reveal">
        <span class="kicker">{h.paths.kicker}</span>
        <h2 set:html={em(h.paths.title)} />
      </div>
      <ul class="paths">
        {
          h.paths.items.map((it, i) => {
            return (
              <li class="reveal">
                <a class="path" href={href(lang, it.slug)}>
                  <span class="path-n">0{i + 1}</span>
                  <span class="path-body">
                    <span class="path-name">{it.name}</span>
                    <span class="path-line">{it.line}</span>
                  </span>
                  <span class="path-go" aria-hidden="true">→</span>
                </a>
              </li>
            );
          })
        }
      </ul>
    </div>
  </section>

  <!-- 4. Comment ça se passe -->
  <section class="band-marine">
    <div class="wrap">
      <div class="section-head reveal">
        <span class="kicker">{h.how.kicker}</span>
        <h2>{h.how.title}</h2>
      </div>
      <div class="steps-line three reveal">
        {h.how.steps.map((s) => <div><b>{s.t}</b><span>{s.d}</span></div>)}
      </div>
    </div>
  </section>

  <!-- 5. Qui je suis -->
  <section class="band-lilas">
    <div class="wrap who">
      <div class="who-photo reveal">
        <img src="/photos/binta-qui-je-suis.webp" alt={h.who.photoAlt} width="844" height="1100" loading="lazy" />
      </div>
      <div class="reveal">
        <span class="kicker">{h.who.kicker}</span>
        <h2 set:html={em(h.who.title)} />
        <p class="lead">{h.who.text}</p>
        <p style="margin-top:28px">
          <a class="textlink" href={href(lang, 'journey')}><span class="arrow">{h.who.link}&nbsp;</span></a>
        </p>
      </div>
    </div>
  </section>

  <!-- 6. Ce que j'ai déjà fait : vidéo + réalisations + photos -->
  <section class="band-marine">
    <div class="wrap">
      <div class="section-head reveal">
        <span class="kicker">{h.proof.kicker}</span>
        <h2 set:html={em(h.proof.title)} />
      </div>
      {
        site.videos.proof && (
          <div class="reveal" style="margin-bottom:clamp(32px,5vw,56px)">
            <MotionVideo
              src={videoPath('preuves', lang).src}
              poster={videoPath('preuves', lang).poster}
              label={h.proof.video}
              soundOn={h.hero.soundOn}
              soundOff={h.hero.soundOff}
              pauseLabel={c.welcome.pause}
              playLabel={c.welcome.resume}
            />
          </div>
        )
      }
      <div class="work-grid">
        {
          h.proof.works.map((x, i) => (
            <>
              {i === 2 && <div class="work-photo tone-violet reveal"><img src="/photos/binta-accueil-violet.webp" alt={h.proof.photoAlt} loading="lazy" width="1108" height="1313" /></div>}
              {i === 4 && <div class="work-photo tone-rouille reveal"><img src="/photos/binta-sourire-detouree.webp" alt={h.proof.photoAlt} loading="lazy" width="1168" height="1013" /></div>}
              <div class="work reveal">
                <span class="work-n">0{i + 1}</span>
                <b>{x.slug ? <a class="rung-link" href={x.slug.startsWith('journey#') ? `${href(lang, 'journey')}#hackathon` : href(lang, x.slug)}>{x.t}</a> : x.t}</b>
                <span>{x.d}</span>
              </div>
            </>
          ))
        }
        <div class="work-photo tone-lilas reveal"><img src="/photos/binta-porte-detouree.webp" alt={h.proof.photoAlt} loading="lazy" width="918" height="1213" /></div>
      </div>
    </div>
  </section>

  <!-- 7. Outils -->
  <!-- 7. Outils -->
  <Marquee label={h.toolsTitle} />

  <!-- 7b. Conseils -->
  <section>
    <div class="wrap">
      <div class="section-head reveal">
        <span class="kicker">{h.tips.kicker}</span>
        <h2 set:html={em(h.tips.title)} />
      </div>
      <div class="pgrid">
        {posts.slice(0, 3).map((p) => <div class="reveal"><PostCard lang={lang} post={p} /></div>)}
      </div>
      <p class="rail-foot reveal" style="margin-top:28px">
        <a class="textlink" href={href(lang, 'blog')}><span class="arrow">{h.tips.link}&nbsp;</span></a>
      </p>
    </div>
  </section>

  <!-- 8. Dans le labo -->
  <section style="background:var(--bg-2);border-block:1px solid var(--line)" id="labo">
    <div class="wrap">
      <LabSection lang={lang} />
    </div>
  </section>

  <CtaBand lang={lang} title={h.finalTitle} text={h.finalText} />
</Base>
