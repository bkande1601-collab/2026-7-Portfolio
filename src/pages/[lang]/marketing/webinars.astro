---
import Base from '../../../layouts/Base.astro';
import CtaMenu from '../../../components/CtaMenu.astro';
import CtaBand from '../../../components/CtaBand.astro';
import Crumb from '../../../components/Crumb.astro';
import MotionVideo from '../../../components/MotionVideo.astro';
import { t, em, href, langs, type Lang } from '../../../content';
import { formatPrice, site, videoPath } from '../../../config/site';

export function getStaticPaths() {
  return langs.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const c = t(lang);
const w = c.marketing.webinars;

const base = formatPrice('webinar', lang);
const basePrice = `${lang === 'fr' ? 'dès' : 'from'} ${base.amount}`;
---

<Base buybar lang={lang} page="marketing/webinars" title={c.nav.sub.webinars} description={w.sub}>
  <!-- Dès l'arrivée : la vidéo de la page -->
  <section class="video-hero">
    <div class="wrap">
      <Crumb lang={lang} parent="marketing" label={c.nav.marketing} />
      {
        site.videos.webinar && (
          <MotionVideo
            src={videoPath('webinaire', lang).src}
            poster={videoPath('webinaire', lang).poster}
            label={c.nav.sub.webinars}
            soundOn={c.home.hero.soundOn}
            soundOff={c.home.hero.soundOff}
            pauseLabel={c.welcome.pause}
            playLabel={c.welcome.resume}
          />
        )
      }
      <div class="video-hero-text">
        <div>
          <span class="kicker">{c.nav.sub.webinars}</span>
          <h1 set:html={em(w.title)} />
          <p class="lead">{w.sub}</p>
        </div>
        <CtaMenu lang={lang} />
      </div>
    </div>
  </section>

  <section class="band-marine">
    <div class="wrap">
      <div class="pipeline reveal">
        {
          w.steps.map((s, i) => (
            <div class="pipe-step">
              <div class="dot">{i + 1}</div>
              <b>{s.t}</b>
              <span>{s.d}</span>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section style="background:var(--bg-2);border-block:1px solid var(--line)">
    <div class="wrap">
      <div class="formulas reveal">
        <div class="formula">
          <span class="formula-tag">{w.base.tag}</span>
          <h3>{w.base.name}</h3>
          <p>{w.base.text}</p>
          <ul class="checks">
            {w.base.items.map((x) => <li>{x}</li>)}
          </ul>
          <p class="formula-price">{basePrice}</p>
        </div>
        <div class="formula plus">
          <span class="formula-tag">{w.custom.tag}</span>
          <h3>{w.custom.name}</h3>
          <p>{w.custom.text}</p>
          <ul class="checks">
            {w.custom.items.map((x) => <li>{x}</li>)}
          </ul>
          <p class="formula-price">{w.quote}</p>
        </div>
      </div>
      <p class="note reveal">{w.quoteNote}</p>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="promise reveal">
        <h3 class="promise-title">{w.promiseTitle}</h3>
        <div class="promise-cols">
          <p><b>{w.promiseYes}</b>{w.yes}</p>
          <p><b>{w.promiseNo}</b>{w.no}</p>
        </div>
      </div>
      <p class="sublinks reveal" style="margin-top:36px">
        <a class="textlink" href={href(lang, 'marketing/content')}><span class="arrow">{c.nav.sub.content}&nbsp;</span></a>
      </p>
    </div>
  </section>

  <CtaBand lang={lang} title={w.finalTitle} text={w.finalText} />
</Base>
