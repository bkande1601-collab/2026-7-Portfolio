---
import Base from '../../../layouts/Base.astro';
import CtaBand from '../../../components/CtaBand.astro';
import Crumb from '../../../components/Crumb.astro';
import { t, em, href, langs, type Lang } from '../../../content';
import { webinarPrices } from '../../../config/site';

export function getStaticPaths() {
  return langs.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const c = t(lang);
const w = c.marketing.webinars;

const money = (n: number | null) =>
  n === null
    ? w.quote
    : new Intl.NumberFormat(lang === 'fr' ? 'fr-FR' : 'en-GB', { maximumFractionDigits: 0, useGrouping: 'always' }).format(n) + ' €';
---

<Base lang={lang} page="marketing/webinars" title={c.nav.sub.webinars} description={w.sub}>
  <section class="page-hero">
    <div class="wrap">
      <Crumb lang={lang} parent="marketing" label={c.nav.marketing} />
      <span class="kicker" style="display:flex">{c.nav.sub.webinars}</span>
      <h1 set:html={em(w.title)} />
      <p class="lead">{w.sub}</p>
      <div class="btn-row" style="margin-top:32px">
        <a class="btn btn-primary" href={href(lang, 'book')}>{c.cta.book}</a>
        <a class="btn btn-ghost" href={href(lang, 'contact')}>{c.cta.message}</a>
      </div>
    </div>
  </section>

  <section style="padding-top:clamp(32px,5vw,64px)">
    <div class="wrap">
      <div class="pipeline reveal">
        {
          w.steps.map((s, i) => (
            <div class="pipe-step">
              <div class="dot">{i + 1}</div>
              <b>{s.t}</b>
              <span>{s.d}</span>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section style="background:var(--bg-2);border-block:1px solid var(--line)">
    <div class="wrap">
      <div class="formulas reveal">
        <div class="formula">
          <span class="formula-tag">{w.setup.tag}</span>
          <h3>{w.setup.name}</h3>
          <p>{w.setup.text}</p>
          <p class="who">{w.setup.who}</p>
          <p class="formula-price">{money(webinarPrices.setup)}</p>
        </div>
        <div class="formula plus">
          <span class="formula-tag">{w.plus.tag}</span>
          <h3>{w.plus.name}</h3>
          <p>{w.plus.text}</p>
          <p class="who">{w.plus.who}</p>
          <p class="formula-price">{money(webinarPrices.plus)}</p>
        </div>
      </div>
      <p class="note reveal">{w.quoteNote}</p>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="promise reveal">
        <h3 class="promise-title">{w.promiseTitle}</h3>
        <div class="promise-cols">
          <p><b>{w.promiseYes}</b>{w.yes}</p>
          <p><b>{w.promiseNo}</b>{w.no}</p>
        </div>
      </div>
      <p class="sublinks reveal" style="margin-top:36px">
        <a class="textlink" href={href(lang, 'marketing/content')}><span class="arrow">{c.nav.sub.content}&nbsp;</span></a>
      </p>
    </div>
  </section>

  <CtaBand lang={lang} title={w.finalTitle} text={w.finalText} />
</Base>
