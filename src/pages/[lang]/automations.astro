---
import Base from '../../layouts/Base.astro';
import CtaMenu from '../../components/CtaMenu.astro';
import BeforeAfter from '../../components/BeforeAfter.astro';
import Marquee from '../../components/Marquee.astro';
import CtaBand from '../../components/CtaBand.astro';
import SubCards from '../../components/SubCards.astro';
import Window from '../../components/Window.astro';
import MotionVideo from '../../components/MotionVideo.astro';
import { t, em, href, langs, type Lang } from '../../content';
import { site } from '../../config/site';

export function getStaticPaths() {
  return langs.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const c = t(lang);
const a = c.automations;
---

<Base buybar lang={lang} page="automations" title={c.nav.automations} description={a.hero.sub}>
  <section class="page-hero has-photo">
    <div class="wrap hero-split wide">
      <div class="hero-text">
      <span class="kicker">{a.hero.kicker}</span>
      <h1 set:html={em(a.hero.title)} />
      <p class="lead">{a.hero.sub}</p>
      <div class="btn-row" style="margin-top:32px">
        <CtaMenu lang={lang} />
      </div>
      </div>
      <img class="hero-photo" src="/photos/binta-sourire-detouree.webp" alt="Binta Kande souriante" width="1168" height="1013" />
    </div>
  </section>

  <!-- Avant tout : ce que j'ai construit -->
  <section class="band-lilas" style="padding-bottom:clamp(48px,7vw,96px)">
    <div class="wrap split">
      <div class="reveal">
        <span class="kicker">{a.built.kicker}</span>
        <h2 set:html={em(a.built.title)} />
        <p class="lead">{a.built.text}</p>
        <ul class="chips">
          {a.built.modules.map((m) => <li>{m}</li>)}
        </ul>
      </div>
      <div class="reveal">
        {
          site.automationsVideo ? (
            <MotionVideo src={site.automationsVideo} poster={site.automationsVideoPoster} label={a.built.kicker} soundOn={c.home.hero.soundOn} soundOff={c.home.hero.soundOff} />
          ) : (
            <Window
              title={c.home.platform.chat.title}
              modules={c.home.platform.modules}
              q={c.home.platform.chat.q}
              a={c.home.platform.chat.a}
              src={c.home.platform.chat.src}
              lock={c.home.platform.chat.lock}
            />
          )
        }
        {!site.automationsVideo && <p class="video-soon">{a.built.videoSoon}</p>}
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="section-head reveal">
        <span class="kicker">{a.overview.kicker}</span>
        <h2 set:html={em(a.overview.title)} />
      </div>
      <SubCards lang={lang} items={a.overview.items} />
    </div>
  </section>

  <section class="band-marine">
    <div class="wrap">
      <BeforeAfter data={c.home.beforeAfter} />
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="section-head reveal">
        <span class="kicker">{a.process.kicker}</span>
        <h2>{a.process.title}</h2>
      </div>
      <div class="steps-line reveal">
        {a.process.steps.map((s) => <div><b>{s.t}</b><span>{s.d}</span></div>)}
      </div>
      <p class="rail-foot reveal" style="margin-top:36px">
        <a class="textlink" href={href(lang, 'offers')}><span class="arrow">{c.nav.offers}&nbsp;</span></a>
      </p>
    </div>
  </section>

  <Marquee label={a.stackTitle} />
  <CtaBand lang={lang} title={a.finalTitle} text={a.finalText} />
</Base>
