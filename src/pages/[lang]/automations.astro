---
import Base from '../../layouts/Base.astro';
import BeforeAfter from '../../components/BeforeAfter.astro';
import Window from '../../components/Window.astro';
import Marquee from '../../components/Marquee.astro';
import CtaBand from '../../components/CtaBand.astro';
import { t, em, href, langs, type Lang } from '../../content';

export function getStaticPaths() {
  return langs.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const c = t(lang);
const a = c.automations;
---

<Base lang={lang} page="automations" title={c.nav.automations} description={a.hero.sub}>
  <section class="page-hero">
    <div class="wrap">
      <span class="kicker">{a.hero.kicker}</span>
      <h1 set:html={em(a.hero.title)} />
      <p class="lead">{a.hero.sub}</p>
      <div class="btn-row" style="margin-top:32px">
        <a class="btn btn-primary" href={href(lang, 'book')}>{c.cta.book}</a>
        <a class="btn btn-ghost" href={href(lang, 'contact')}>{c.cta.message}</a>
      </div>
    </div>
  </section>

  <!-- Pipeline : un exemple concret -->
  <section style="padding-top:clamp(32px,5vw,64px)">
    <div class="wrap">
      <div class="section-head reveal">
        <span class="kicker">{a.flow.kicker}</span>
        <h2 set:html={em(a.flow.title)} />
      </div>
      <div class="pipeline reveal">
        {
          a.flow.steps.map((s, i) => (
            <div class="pipe-step">
              <div class="dot">{i + 1}</div>
              <b>{s.t}</b>
              <span>{s.d}</span>
            </div>
          ))
        }
      </div>
      <p class="note reveal">{a.flow.note}</p>
    </div>
  </section>

  <section style="background:var(--bg-2);border-block:1px solid var(--line)">
    <div class="wrap">
      <BeforeAfter data={c.home.beforeAfter} />
    </div>
  </section>

  <!-- Agent IA -->
  <section>
    <div class="wrap split">
      <div class="reveal">
        <span class="kicker">{a.agent.kicker}</span>
        <h2 set:html={em(a.agent.title)} />
        <p class="lead">{a.agent.text}</p>
      </div>
      <div class="reveal">
        <Window title={a.agent.kicker} q={a.agent.q} a={a.agent.a} src={a.agent.src} lock={c.home.platform.chat.lock} />
      </div>
    </div>
  </section>

  <!-- Outil interne -->
  <section style="padding-top:0">
    <div class="wrap split rev">
      <div class="reveal">
        <Window
          title={c.home.platform.chat.title}
          modules={c.home.platform.modules}
          q={c.home.platform.chat.q}
          a={c.home.platform.chat.a}
          src={c.home.platform.chat.src}
          lock={c.home.platform.chat.lock}
        />
      </div>
      <div class="reveal">
        <span class="kicker">{a.tool.kicker}</span>
        <h2 set:html={em(a.tool.title)} />
        <p class="lead">{a.tool.text}</p>
        <p class="stack-line" style="margin-top:20px">{c.home.platform.stack}</p>
      </div>
    </div>
  </section>

  <!-- Process -->
  <section style="background:var(--bg-2);border-block:1px solid var(--line)">
    <div class="wrap">
      <div class="section-head reveal">
        <span class="kicker">{a.process.kicker}</span>
        <h2>{a.process.title}</h2>
      </div>
      <div class="steps-line reveal">
        {a.process.steps.map((s) => <div><b>{s.t}</b><span>{s.d}</span></div>)}
      </div>
      <p class="rail-foot reveal" style="margin-top:36px">
        <a class="textlink" href={href(lang, 'offers')}><span class="arrow">{c.nav.offers}&nbsp;</span></a>
      </p>
    </div>
  </section>

  <Marquee label={a.stackTitle} />
  <CtaBand lang={lang} title={a.finalTitle} text={a.finalText} />
</Base>
