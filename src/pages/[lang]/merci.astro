---
import Base from '../../layouts/Base.astro';
import { t, href, type Lang } from '../../content';
import { hasDb, db } from '../../lib/db';
import { hasStripe, isProduct } from '../../lib/stripe';
import { syncOrder, productName } from '../../lib/orders';
import { questionnaires } from '../../config/questionnaires';
import { PICK, promptTypes } from '../../config/masterPrompts';
import { deliveryPromise } from '../../lib/settings';

export const prerender = false;

const lang: Lang = Astro.params.lang === 'en' ? 'en' : 'fr';
const fr = lang === 'fr';
const c = t(lang);
Astro.response.headers.set('Cache-Control', 'no-store');

const sessionId = Astro.url.searchParams.get('session_id') ?? '';
let state: 'unconfigured' | 'unknown' | 'pending' | 'form' | 'done' | 'error' = 'unconfigured';
let product: 'diagnostic' | 'prompt' | null = null;
const refaire = Astro.url.searchParams.get('refaire') === '1';
let prefill: Record<string, string> = {};
let preTypes = ''; // master prompt : types déjà choisis avant le paiement

const devPreview = import.meta.env.DEV ? Astro.url.searchParams.get('apercu') : null; // aperçu local du formulaire, absent en production
if (devPreview === 'prompt' || devPreview === 'diagnostic') {
  product = devPreview;
  state = 'form';
} else if (hasDb() && hasStripe() && /^cs_[A-Za-z0-9_]+$/.test(sessionId)) {
  try {
    const order = await syncOrder(sessionId);
    if (!order) state = 'unknown';
    else if (order.status === 'pending' || order.status === 'failed' || order.status === 'expired') state = 'pending';
    else if (isProduct(order.product)) {
      product = order.product;
      preTypes = order.prompt_types ?? '';
      const a = await db().query<{ data: { id: string; value: string }[] }>('SELECT data FROM answers WHERE order_id = $1', [order.id]);
      if (a.rowCount && refaire) prefill = Object.fromEntries(a.rows[0].data.map((x) => [x.id, x.value]));
      state = a.rowCount && !refaire ? 'done' : 'form';
    } else state = 'unknown';
  } catch (e) {
    console.error('merci: order lookup failed', (e as { code?: string }).code, (e as Error).message);
    state = 'error';
  }
} else if (hasDb() && hasStripe()) {
  state = 'unknown';
}

const questions = product ? questionnaires[product] : [];
const promise = hasDb() ? await deliveryPromise(lang, product ?? 'diagnostic').catch(() => '') : '';
const L = {
  kicker: fr ? 'Merci pour votre commande' : 'Thank you for your order',
  title: fr ? 'Quelques questions pour préparer votre résultat' : 'A few questions to prepare your result',
  lead: fr ? 'Prenez 5 minutes. Plus vos réponses sont précises, plus votre résultat l’est.' : 'Take 5 minutes. The more precise your answers, the more precise your result.',
  banner: product === 'prompt' ? (fr ? 'Plus vous donnez d’informations, meilleurs seront vos master prompts.' : 'The more information you give, the better your master prompts.') : (fr ? 'Plus vous donnez d’informations, meilleur sera votre audit.' : 'The more information you give, the better your audit.'),
  pickLeft: fr ? 'choisi' : 'chosen',
  pickInvalid: fr ? 'Choisissez exactement 2 master prompts.' : 'Please choose exactly 2 master prompts.',
  bannerText: fr ? 'Chaque détail compte : des chiffres, des exemples, des noms d’outils. Une réponse de 3 mots donne un conseil générique ; une réponse de 3 phrases donne un conseil sur mesure. Un exemple est affiché dans chaque champ pour vous guider. Vos réponses sont enregistrées sur votre appareil au fur et à mesure : vous pouvez faire une pause.' : 'Every detail counts: numbers, examples, tool names. A 3-word answer gives generic advice; a 3-sentence answer gives tailored advice. An example is shown in each field to guide you. Your answers are saved on your device as you go: you can take a break.',
  short: fr ? 'On vous recommande d’écrire plus : ajoutez des détails (chiffres, exemples) pour un résultat plus précis. Vous pouvez quand même envoyer.' : 'We recommend writing more: add details (numbers, examples) for a more precise result. You can still send as is.',
  good: fr ? 'Très bien, c’est précis.' : 'Great, that is precise.',
  chars: fr ? 'caractères' : 'characters',
  warnSubmit: fr ? 'Plusieurs réponses sont courtes : on vous recommande d’en écrire plus pour un diagnostic plus précis. Vous pouvez quand même envoyer.' : 'Several answers are short: we recommend writing more for a more precise diagnostic. You can still send as is.',
  progress: fr ? 'questions renseignées' : 'questions answered',
  send: fr ? 'Envoyer mes réponses' : 'Send my answers',
  sending: fr ? 'Envoi…' : 'Sending…',
  optional: fr ? 'facultatif' : 'optional',
  err: fr ? 'Une erreur est survenue. Réessayez dans un instant.' : 'Something went wrong. Please try again in a moment.',
  invalid: fr ? 'Merci de remplir les champs obligatoires.' : 'Please fill in the required fields.',
  okTitle: fr ? 'C’est reçu, merci.' : 'Received, thank you.',
  okText: fr ? `Je lis vos réponses et je prépare votre résultat. Vous le recevrez par e-mail ${promise}.` : `I am reading your answers and preparing your result. You will receive it by email ${promise}.`,
  pendingTitle: fr ? 'Votre paiement est en cours de confirmation' : 'Your payment is being confirmed',
  pendingText: fr ? 'Cela peut prendre quelques instants. Rechargez la page dans une minute.' : 'This can take a moment. Reload the page in a minute.',
  errorTitle: fr ? 'Votre paiement est bien reçu' : 'Your payment has been received',
  errorText: fr ? 'Le questionnaire est momentanément indisponible. Vous recevrez un e-mail avec le lien pour le remplir dans quelques minutes. Sans nouvelle de ma part, écrivez-moi à hello@bintakande.com.' : 'The questionnaire is temporarily unavailable. You will receive an email with the link to fill it in within a few minutes. If you hear nothing, write to me at hello@bintakande.com.',
  unknownTitle: fr ? 'Commande introuvable' : 'Order not found',
  unknownText: fr ? 'Ouvrez le lien reçu par e-mail après votre paiement, ou écrivez-moi.' : 'Open the link you received by email after your payment, or write to me.',
  thanksText: fr ? 'Merci pour votre commande. Vous recevrez un e-mail avec la suite.' : 'Thank you for your order. You will receive an email with the next steps.',
};
---

<Base lang={lang} page="merci" title={L.kicker} noindex>
  <section class="page-hero">
    <div class="wrap">
      <span class="kicker">{L.kicker}</span>
      {state === 'form' && (
        <>
          <h1>{L.title}</h1>
          <p class="lead">{productName(product!, lang)}. {L.lead}</p>
        </>
      )}
      {state === 'done' && <h1>{L.okTitle}</h1>}
      {state === 'pending' && <h1>{L.pendingTitle}</h1>}
      {state === 'unknown' && <h1>{L.unknownTitle}</h1>}
      {state === 'error' && <h1>{L.errorTitle}</h1>}
      {state === 'unconfigured' && <h1>{L.okTitle}</h1>}
    </div>
  </section>

  <section style="padding-top:clamp(16px,3vw,32px)">
    <div class="wrap">
      {state === 'form' && (
        <div class="q-banner">
          <strong>{L.banner}</strong>
          <p>{L.bannerText}</p>
          <div class="q-progress" aria-live="polite"><span id="q-count">0</span>/<span id="q-total">{questions.filter((q) => !q.when).length}</span> {L.progress}<i><b id="q-bar"></b></i></div>
        </div>
        <form class="form" id="q-form" novalidate data-session={sessionId} data-warn={L.warnSubmit}>
          {questions.map((q, i) => (
            <div class="q-item" data-when={q.when} hidden={Boolean(q.when)}>
              {q.section && (i === 0 || questions[i - 1].section?.fr !== q.section.fr) && <h2 class="q-sec">{q.section[lang]}</h2>}
              {q.type === 'choice' ? (
                <fieldset class="field q-pick" id="q-types" data-pick={PICK} data-pre={preTypes}>
                  <legend>{q.label[lang]} <span class="q-pickcount"><b id="q-pickn">0</b>/{PICK} {L.pickLeft}</span></legend>
                  {q.hint && <p class="q-hint">{q.hint[lang]}</p>}
                  <div class="q-cards">
                    {promptTypes.map((t) => (
                      <label class="q-card">
                        <input type="checkbox" name="types" value={t.id} />
                        <span class="q-card-b"><strong>{t.name[lang]}</strong><em>{t.tagline[lang]}</em><small>{t.gets[lang]}</small></span>
                      </label>
                    ))}
                  </div>
                </fieldset>
              ) : (
                <div class="field">
                  <label for={`q-${q.id}`}>
                    {q.label[lang]} {!q.required && <span>({L.optional})</span>}
                  </label>
                  {q.hint && <p class="q-hint">{q.hint[lang]}</p>}
                  {q.type === 'textarea' ? (
                    <textarea id={`q-${q.id}`} name={q.id} rows="4" data-required={q.required ? '1' : ''} data-min={q.min ?? ''} maxlength="6000" placeholder={q.example?.[lang] ?? ''}>{prefill[q.id] ?? ''}</textarea>
                  ) : (
                    <input id={`q-${q.id}`} name={q.id} type="text" data-required={q.required ? '1' : ''} data-min={q.min ?? ''} maxlength="6000" placeholder={q.example?.[lang] ?? ''} value={prefill[q.id] ?? ''} />
                  )}
                  <p class="q-note" data-for={q.id} aria-live="polite"></p>
                </div>
              )}
            </div>
          ))}
          <p class="q-advice" id="q-adv" aria-live="polite"></p>
          <p class="form-msg" id="q-msg" role="alert" aria-live="polite"></p>
          <div class="btn-row">
            <button class="btn btn-primary" type="submit" id="q-submit">{L.send}</button>
          </div>
        </form>
      )}

      <div class="success" id="q-success" hidden={state !== 'done'} tabindex="-1">
        <h2>{L.okTitle}</h2>
        <p>{L.okText}</p>
        <div class="btn-row" style="margin-top:24px">
          <a class="btn btn-ghost" href={href(lang)}>{fr ? 'Retour à l’accueil' : 'Back to home'}</a>
        </div>
      </div>

      {state === 'pending' && <p class="lead">{L.pendingText}</p>}
      {state === 'unknown' && <p class="lead">{L.unknownText}</p>}
      {state === 'error' && <p class="lead">{L.errorText}</p>}
      {state === 'unconfigured' && <p class="lead">{L.thanksText}</p>}
    </div>
  </section>

  <script type="application/json" id="q-i18n" set:html={JSON.stringify({ err: L.err, invalid: L.invalid, send: L.send, sending: L.sending, short: L.short, good: L.good, chars: L.chars, pickInvalid: L.pickInvalid, lang })} />
</Base>

<style>
  .q-banner { background: var(--surface-2); border-left: 5px solid var(--violet); border-radius: 14px; padding: 18px 22px; margin: 0 0 28px; }
  .q-banner strong { color: var(--heading); font-size: 1.1rem; }
  .q-banner p { margin: 8px 0 12px; font-size: .95rem; color: var(--text); }
  .q-progress { font-size: .85rem; color: var(--muted); }
  .q-progress i { display: block; height: 6px; border-radius: 99px; background: rgba(105, 76, 172, .18); margin-top: 6px; overflow: hidden; }
  .q-progress b { display: block; height: 100%; width: 0; background: var(--violet); border-radius: 99px; transition: width .3s var(--ease); }
  .q-sec { font-size: 1.25rem; margin: 40px 0 6px; padding-top: 18px; border-top: 2px solid var(--line); color: var(--heading); }
  .q-hint { margin: 0 0 6px; opacity: .75; font-size: .9em; }
  .q-note { margin: 6px 0 0; font-size: .85rem; min-height: 1.1em; }
  .q-note.short { color: #9a6700; font-weight: 600; }
  .q-advice { margin: 18px 0 0; font-size: .92rem; font-weight: 600; color: #9a6700; }
  .q-advice:empty { display: none; }
  .q-note.good { color: #1f7a4d; }
  .q-item[hidden] { display: none; }
  .q-pick { border: 0; padding: 0; margin: 0 0 8px; min-width: 0; }
  .q-pick legend { font-weight: 700; color: var(--heading); padding: 0; margin-bottom: 4px; }
  .q-pickcount { font-weight: 600; font-size: .85rem; color: var(--violet); margin-left: 6px; }
  .q-cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 240px), 1fr)); gap: 12px; margin-top: 10px; }
  .q-card { position: relative; display: block; cursor: pointer; }
  .q-card input { position: absolute; opacity: 0; inset: 0; width: 100%; height: 100%; margin: 0; cursor: pointer; }
  .q-card-b { display: flex; flex-direction: column; gap: 5px; height: 100%; padding: 16px 18px; border-radius: 14px; border: 2px solid var(--line); background: var(--surface-2); transition: border-color .2s var(--ease), background .2s var(--ease), opacity .2s; }
  .q-card-b strong { color: var(--heading); font-size: 1.05rem; }
  .q-card-b em { font-style: normal; font-size: .88rem; color: var(--text); }
  .q-card-b small { font-size: .8rem; color: var(--muted); }
  .q-card input:checked + .q-card-b { border-color: var(--violet); background: rgba(105, 76, 172, .1); }
  .q-card input:focus-visible + .q-card-b { outline: 3px solid var(--violet); outline-offset: 2px; }
  .q-card input:disabled + .q-card-b { opacity: .45; cursor: not-allowed; }
  textarea::placeholder, input::placeholder { color: var(--taupe); font-style: italic; opacity: .85; }
  textarea:focus::placeholder { opacity: .45; }
</style>

<script>
  const form = document.getElementById('q-form') as HTMLFormElement | null;
  if (form) {
    const msg = document.getElementById('q-msg')!;
    const success = document.getElementById('q-success')!;
    const btn = document.getElementById('q-submit') as HTMLButtonElement;
    const t = JSON.parse(document.getElementById('q-i18n')!.textContent || '{}');
    const allFields = Array.from(form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('input:not([type=checkbox]), textarea'));
    const picks = Array.from(form.querySelectorAll<HTMLInputElement>('input[name=types]'));
    const pickMax = picks.length ? Number(form.querySelector<HTMLElement>('#q-types')!.dataset.pick) : 0;
    // champs réellement affichés (les questions d'un type non choisi sont masquées)
    const visible = () => allFields.filter((el) => !el.closest('.q-item[hidden]'));
    const chosen = () => picks.filter((p) => p.checked).map((p) => p.value);
    const draftKey = `q-draft:${form.dataset.session}`;
    // choix fait avant le paiement : déjà coché, modifiable
    const pre = picks.length ? (form.querySelector<HTMLElement>('#q-types')!.dataset.pre || '') : '';
    if (pre) picks.forEach((p) => { p.checked = pre.split(',').includes(p.value); });

    // brouillon enregistré sur l'appareil (jamais envoyé tant que le formulaire n'est pas validé)
    try {
      const saved = JSON.parse(localStorage.getItem(draftKey) || '{}');
      allFields.forEach((el) => { if (!el.value && saved[el.name]) el.value = saved[el.name]; });
      if (typeof saved.types === 'string' && saved.types) picks.forEach((p) => { p.checked = saved.types.split(',').includes(p.value); });
    } catch {}

    const shortCount = () => visible().filter((el) => el.dataset.min && el.value.trim() && el.value.trim().length < Number(el.dataset.min)).length;

    function refresh(el?: HTMLInputElement | HTMLTextAreaElement) {
      const vis = visible();
      const done = vis.filter((f) => f.value.trim()).length + (picks.length && chosen().length === pickMax ? 1 : 0);
      const total = vis.length + (picks.length ? 1 : 0);
      document.getElementById('q-count')!.textContent = String(done);
      const totalEl = document.getElementById('q-total');
      if (totalEl) totalEl.textContent = String(total);
      (document.getElementById('q-bar') as HTMLElement).style.width = `${Math.round((done / Math.max(total, 1)) * 100)}%`;
      const list = el ? [el] : vis;
      list.forEach((f) => {
        const note = form!.querySelector<HTMLElement>(`.q-note[data-for="${f.name}"]`);
        if (!note) return;
        const len = f.value.trim().length;
        const min = Number(f.dataset.min || 0);
        note.className = 'q-note';
        if (!len || !min) { note.textContent = ''; return; }
        if (len < min) { note.textContent = `${t.short} (${len}/${min} ${t.chars})`; note.classList.add('short'); }
        else { note.textContent = t.good; note.classList.add('good'); }
      });
    }

    const saveDraft = () => {
      try {
        const data: Record<string, string> = {};
        allFields.forEach((f) => { if (f.value) data[f.name] = f.value; });
        if (picks.length) data.types = chosen().join(',');
        localStorage.setItem(draftKey, JSON.stringify(data));
      } catch {}
    };
    allFields.forEach((el) => el.addEventListener('input', () => {
      refresh(el);
      adv.textContent = shortCount() >= 3 ? (form.dataset.warn || '') : '';
      saveDraft();
    }));
    // choix des 2 master prompts : au maximum 2, et seules les questions des types choisis s'affichent
    const syncPicks = () => {
      const on = chosen();
      picks.forEach((p) => { p.disabled = !p.checked && on.length >= pickMax; });
      form.querySelectorAll<HTMLElement>('.q-item[data-when]').forEach((box) => { box.hidden = !on.includes(box.dataset.when!); });
      const n = document.getElementById('q-pickn');
      if (n) n.textContent = String(on.length);
      refresh();
    };
    picks.forEach((p) => p.addEventListener('change', () => { syncPicks(); saveDraft(); }));
    const adv = document.getElementById('q-adv')!;
    syncPicks();
    adv.textContent = shortCount() >= 3 ? (form.dataset.warn || '') : '';

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const answers: Record<string, string> = {};
      let missing: HTMLElement | null = null;
      visible().forEach((el) => {
        answers[el.name] = el.value.trim();
        if (el.dataset.required && !el.value.trim() && !missing) missing = el;
      });
      msg.className = 'form-msg';
      if (picks.length) {
        answers.types = chosen().join(',');
        if (chosen().length !== pickMax) {
          msg.textContent = t.pickInvalid;
          msg.classList.add('err');
          document.getElementById('q-types')!.scrollIntoView({ behavior: 'smooth', block: 'center' });
          return;
        }
      }
      if (missing) {
        msg.textContent = t.invalid;
        msg.classList.add('err');
        (missing as HTMLElement).scrollIntoView({ behavior: 'smooth', block: 'center' });
        (missing as HTMLElement).focus();
        return;
      }
      btn.disabled = true;
      btn.textContent = t.sending;
      try {
        const res = await fetch('/api/questionnaire', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ session_id: form.dataset.session, answers }),
        });
        if (!res.ok) throw new Error(String(res.status));
        try { localStorage.removeItem(draftKey); } catch {}
        form.hidden = true;
        document.querySelector('.q-banner')?.setAttribute('hidden', '');
        success.hidden = false;
        success.focus();
        window.scrollTo({ top: 0, behavior: 'smooth' });
      } catch {
        msg.textContent = t.err;
        msg.classList.add('err');
        btn.disabled = false;
        btn.textContent = t.send;
      }
    });
  }
</script>
