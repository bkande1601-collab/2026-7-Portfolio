---
import Base from '../../layouts/Base.astro';
import CtaBand from '../../components/CtaBand.astro';
import ResourceBox from '../../components/ResourceBox.astro';
import { t, em, langs, type Lang } from '../../content';
import resources from '../../content/resources.json';

export function getStaticPaths() {
  return langs.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const c = t(lang);
const b = c.blog;
---

<Base lang={lang} page="resources" title={c.nav.resources} description={b.resources.sub}>
  <section class="page-hero">
    <div class="wrap">
      <span class="kicker">{c.nav.resources}</span>
      <h1 set:html={em(b.resources.title)} />
      <p class="lead">{b.resources.sub}</p>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="rgrid">
        {resources.map((r, i) => <ResourceBox lang={lang} slug={r.slug} first={i === 0} card />)}
      </div>
      <p class="note reveal">{b.resource.consent}</p>
    </div>
  </section>

  <CtaBand lang={lang} title={b.ctaTitle} text={b.ctaText} />
</Base>
