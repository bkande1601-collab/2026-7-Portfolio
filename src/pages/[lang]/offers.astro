---
import Base from '../../layouts/Base.astro';
import CtaBand from '../../components/CtaBand.astro';
import CtaMenu from '../../components/CtaMenu.astro';
import { t, em, href, langs, type Lang } from '../../content';
import { formatPrice, type PriceKey } from '../../config/site';

export function getStaticPaths() {
  return langs.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const c = t(lang);
const o = c.offers;

const price = (k: PriceKey) => formatPrice(k, lang);
---

<Base lang={lang} page="offers" title={c.nav.offers} description={o.hero.sub}>
  <section class="page-hero">
    <div class="wrap">
      <span class="kicker">{o.hero.kicker}</span>
      <h1 set:html={em(o.hero.title)} />
      <p class="lead">{o.hero.sub}</p>
    </div>
  </section>

  <!-- Le premier échange est gratuit -->
  <section class="band-lilas" style="padding-block:clamp(36px,5vw,56px)">
    <div class="wrap free-call reveal">
      <div>
        <h2 set:html={em(o.free.title)} />
        <p class="lead">{o.free.text}</p>
      </div>
      <CtaMenu lang={lang} />
    </div>
  </section>

  <!-- L'échelle -->
  <section>
    <div class="wrap">
      <ol class="ladder">
        {
          o.ladder.map((r, i) => {
            const p = price(r.key as PriceKey);
            return (
              <li class="rung reveal" style={`--i:${i}`}>
                <div class="name"><h3><a class="rung-link" href={href(lang, r.href)}>{r.name}</a></h3></div>
                <p class="line">{r.line}</p>
                <p class="out">{r.out}</p>
                <div class="price">
                  <span class="price-f">{p.from ? o.from : p.range ? ' ' : o.flat}</span>
                  <span class="price-n">{p.amount}</span>
                </div>
              </li>
            );
          })
        }
      </ol>
      <p class="price-quote">{o.quote}</p>
    </div>
  </section>

  <!-- Et aussi -->
  <section class="band-marine">
    <div class="wrap">
      <div class="section-head reveal">
        <span class="kicker">{o.otherKicker}</span>
      </div>
      <ul class="other-list">
        {
          o.other.map((s) => {
            const p = s.key ? price(s.key as PriceKey) : null;
            return (
              <li class="reveal">
                <div>
                  <h3>{(s as { href?: string }).href ? <a class="rung-link" href={href(lang, (s as { href?: string }).href as string)}>{s.name}</a> : s.name}</h3>
                  <p>{s.line}</p>
                </div>
                <div class="price-n">
                  {p ? (
                    <>
                      <small style="display:block;font-size:.5em;letter-spacing:.1em;text-transform:uppercase;font-weight:400">{o.from}</small>
                      {p.amount}<small> {o.perMonth}</small>
                    </>
                  ) : (
                    <span style="font-size:.8em">{(s as { custom?: string }).custom}</span>
                  )}
                </div>
              </li>
            );
          })
        }
      </ul>
    </div>
  </section>

  <CtaBand lang={lang} title={o.finalTitle} text={o.finalText} />
</Base>
