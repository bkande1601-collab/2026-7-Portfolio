---
import Base from '../../layouts/Base.astro';
import CtaBand from '../../components/CtaBand.astro';
import { t, em, href, langs, type Lang } from '../../content';
import { formatPrice, webinarPrices } from '../../config/site';

export function getStaticPaths() {
  return langs.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const c = t(lang);
const m = c.marketing;
const w = m.webinars;

const money = (n: number | null) =>
  n === null
    ? w.quote
    : new Intl.NumberFormat(lang === 'fr' ? 'fr-FR' : 'en-GB', { maximumFractionDigits: 0, useGrouping: 'always' }).format(n) + ' €';
const monthly = formatPrice('marketing', lang);
---

<Base lang={lang} page="marketing" title={c.nav.marketing} description={m.hero.sub}>
  <section class="page-hero">
    <div class="wrap">
      <span class="kicker">{m.hero.kicker}</span>
      <h1 set:html={em(m.hero.title)} />
      <p class="lead">{m.hero.sub}</p>
      <div class="btn-row" style="margin-top:32px">
        <a class="btn btn-primary" href={href(lang, 'book')}>{c.cta.book}</a>
        <a class="btn btn-ghost" href={href(lang, 'contact')}>{c.cta.message}</a>
      </div>
    </div>
  </section>

  <!-- 1. Contenu réseaux : le parcours -->
  <section style="padding-top:clamp(32px,5vw,64px)">
    <div class="wrap">
      <div class="section-head reveal">
        <span class="kicker">{m.content.kicker}</span>
        <h2 set:html={em(m.content.title)} />
      </div>
      <div class="pipeline reveal">
        {
          m.content.steps.map((s, i) => (
            <div class="pipe-step">
              <div class="dot">{i + 1}</div>
              <b>{s.t}</b>
              <span>{s.d}</span>
            </div>
          ))
        }
      </div>
      <p class="note reveal">{m.content.note}</p>
    </div>
  </section>

  <!-- 2. La formule mensuelle -->
  <section style="background:var(--bg-2);border-block:1px solid var(--line)">
    <div class="wrap monthly">
      <div class="reveal">
        <span class="kicker">{m.monthly.kicker}</span>
        <h2>{m.monthly.name}</h2>
        <p class="lead">{m.monthly.text}</p>
        <div class="btn-row" style="margin-top:28px">
          <a class="btn btn-primary" href={href(lang, 'book')}>{c.cta.book}</a>
        </div>
      </div>
      <div class="monthly-price reveal">
        <small>{m.monthly.from}</small>
        <b>{monthly.n} €</b>
        <span>{m.monthly.perMonth}</span>
      </div>
    </div>
  </section>

  <!-- 3. Et aussi -->
  <section>
    <div class="wrap">
      <div class="section-head reveal">
        <span class="kicker">{m.also.kicker}</span>
      </div>
      <div class="also reveal">
        {m.also.items.map((it) => <div><b>{it.t}</b><span>{it.d}</span></div>)}
      </div>
    </div>
  </section>

  <!-- 4. D'où vient l'expérience -->
  <section style="padding-top:0">
    <div class="wrap">
      <div class="section-head reveal">
        <span class="kicker">{m.proof.kicker}</span>
        <h2 set:html={em(m.proof.title)} />
      </div>
      <ul class="proof">
        {
          m.proof.items.map((it) => (
            <li class="reveal">
              <div class="proof-who"><b>{it.who}</b><span>{it.role}</span></div>
              <p>{it.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 5. Webinaires, après le contenu -->
  <section style="background:var(--bg-2);border-block:1px solid var(--line)" id="webinaires">
    <div class="wrap">
      <div class="section-head reveal">
        <span class="kicker">{w.kicker}</span>
        <h2 set:html={em(w.title)} />
        <p class="lead">{w.sub}</p>
      </div>
      <div class="pipeline reveal">
        {
          w.steps.map((s, i) => (
            <div class="pipe-step">
              <div class="dot">{i + 1}</div>
              <b>{s.t}</b>
              <span>{s.d}</span>
            </div>
          ))
        }
      </div>

      <div class="formulas reveal" style="margin-top:clamp(32px,5vw,56px)">
        <div class="formula">
          <span class="formula-tag">{w.setup.tag}</span>
          <h3>{w.setup.name}</h3>
          <p>{w.setup.text}</p>
          <p class="who">{w.setup.who}</p>
          <p class="formula-price">{money(webinarPrices.setup)}</p>
        </div>
        <div class="formula plus">
          <span class="formula-tag">{w.plus.tag}</span>
          <h3>{w.plus.name}</h3>
          <p>{w.plus.text}</p>
          <p class="who">{w.plus.who}</p>
          <p class="formula-price">{money(webinarPrices.plus)}</p>
        </div>
      </div>
      <p class="note reveal">{w.quoteNote}</p>

      <div class="promise reveal" style="margin-top:clamp(40px,6vw,72px)">
        <h3 class="promise-title">{w.promiseTitle}</h3>
        <div class="promise-cols">
          <p><b>{w.promiseYes}</b>{w.yes}</p>
          <p><b>{w.promiseNo}</b>{w.no}</p>
        </div>
      </div>
    </div>
  </section>

  <CtaBand lang={lang} title={m.finalTitle} text={m.finalText} />
</Base>
