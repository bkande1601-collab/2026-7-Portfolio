---
import Base from '../../layouts/Base.astro';
import CtaMenu from '../../components/CtaMenu.astro';
import CtaBand from '../../components/CtaBand.astro';
import SubCards from '../../components/SubCards.astro';
import { t, em, href, langs, type Lang } from '../../content';

export function getStaticPaths() {
  return langs.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const c = t(lang);
const m = c.marketing;
---

<Base buybar service lang={lang} page="marketing" title={c.nav.marketing} description={m.intro.sub}>
  <section class="page-hero has-photo">
    <div class="wrap hero-split">
      <div class="hero-text">
      <span class="kicker">{m.hero.kicker}</span>
      <h1 set:html={em(m.intro.title)} />
      <p class="lead">{m.intro.sub}</p>
      <div class="btn-row" style="margin-top:32px">
        <CtaMenu lang={lang} />
      </div>
      </div>
      <img class="hero-photo" src="/photos/binta-porte-detouree.webp" alt="Binta Kande en lunettes de soleil devant une porte en bois" width="918" height="1213" />
    </div>
  </section>

  <section style="padding-top:clamp(32px,5vw,64px)">
    <div class="wrap">
      <div class="section-head reveal">
        <span class="kicker">{m.overview.kicker}</span>
        <h2 set:html={em(m.overview.title)} />
      </div>
      <SubCards lang={lang} items={m.overview.items} />
    </div>
  </section>

  <!-- D'où vient l'expérience -->
  <section style="background:var(--bg-2);border-block:1px solid var(--line)">
    <div class="wrap">
      <div class="section-head reveal">
        <span class="kicker">{m.proof.kicker}</span>
        <h2 set:html={em(m.proof.title)} />
      </div>
      <ul class="proof">
        {
          m.proof.items.map((it) => (
            <li class="reveal">
              <div class="proof-who"><b>{it.who}</b><span>{it.role}</span></div>
              <p>{it.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- En construction -->
  <section class="band-lilas" style="padding-bottom:clamp(48px,7vw,96px)">
    <div class="wrap split">
      <div class="reveal">
        <span class="kicker">{m.building.kicker}</span>
        <h2 set:html={em(m.building.title)} />
        <p class="lead">{m.building.text}</p>
        <p style="margin-top:26px">
          <a class="textlink" href={`${href(lang)}#labo`}><span class="arrow">{m.building.link}&nbsp;</span></a>
        </p>
      </div>
    </div>
  </section>

  <CtaBand lang={lang} title={m.finalTitle} text={m.finalText} />
</Base>
