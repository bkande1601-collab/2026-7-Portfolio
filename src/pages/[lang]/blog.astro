---
import Base from '../../layouts/Base.astro';
import CtaBand from '../../components/CtaBand.astro';
import PostCard from '../../components/PostCard.astro';
import { t, em, langs, type Lang } from '../../content';
import { posts } from '../../content/blog';

export function getStaticPaths() {
  return langs.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const c = t(lang);
const b = c.blog;
const [first, ...rest] = posts;
const origin = Astro.site ? Astro.site.origin : '';
const blogLd = { '@context': 'https://schema.org', '@type': 'Blog', name: `${c.nav.blog} | Binta Kande`, url: `${origin}/${lang}/blog`, inLanguage: lang, blogPost: posts.map((p) => ({ '@type': 'BlogPosting', headline: p[lang].title, url: `${origin}/${lang}/blog/${p.slug}`, datePublished: p.date })) };
---

<Base lang={lang} page="blog" title={c.nav.blog} description={b.hero.sub} jsonLd={[blogLd]}>
  <section class="page-hero">
    <div class="wrap">
      <span class="kicker">{b.hero.kicker}</span>
      <h1 set:html={em(b.hero.title)} />
      <p class="lead">{b.hero.sub}</p>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="reveal"><PostCard lang={lang} post={first} big /></div>
      <div class="pgrid">
        {rest.map((p) => <div class="reveal"><PostCard lang={lang} post={p} /></div>)}
      </div>
    </div>
  </section>

  <CtaBand lang={lang} title={b.ctaTitle} text={b.ctaText} />
</Base>
