---
import Base from '../../layouts/Base.astro';
import { t, em, href, langs, type Lang } from '../../content';
import { booking } from '../../config/site';

export function getStaticPaths() {
  return langs.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const c = t(lang);
const b = c.book;

// textes et libellés passés au script du navigateur
const i18n = {
  ...b,
  lang,
  duration: booking.durationMin,
  needs: Object.fromEntries(b.needs.map((n) => [n.v, n.t])),
  budgets: Object.fromEntries(b.budgets.map((n) => [n.v, n.t])),
};
---

<Base lang={lang} page="book" title={c.cta.book} description={b.hero.sub}>
  <section class="page-hero">
    <div class="wrap">
      <span class="kicker">{b.hero.kicker}</span>
      <h1 set:html={em(b.hero.title)} />
      <p class="lead">{b.hero.sub}</p>
    </div>
  </section>

  <section style="padding-top:clamp(16px,3vw,32px)">
    <div class="wrap booking-layout">
      <ol class="stepper" id="stepper" aria-label="Progression">
        {b.steps.map((s, i) => <li data-i={i}><b>{i + 1}</b>{s}</li>)}
      </ol>

      <!-- Étape 1 : la demande -->
      <form class="form" id="step-1" novalidate>
        <div class="two">
          <div class="field">
            <label for="b-first">{b.fields.firstName}</label>
            <input id="b-first" name="firstName" type="text" autocomplete="given-name" required />
          </div>
          <div class="field">
            <label for="b-last">{b.fields.lastName}</label>
            <input id="b-last" name="lastName" type="text" autocomplete="family-name" required />
          </div>
        </div>
        <div class="two">
          <div class="field">
            <label for="b-phone">{b.fields.phone}</label>
            <input id="b-phone" name="phone" type="tel" inputmode="tel" autocomplete="tel" required />
          </div>
          <div class="field">
            <label for="b-email">{b.fields.email}</label>
            <input id="b-email" name="email" type="email" inputmode="email" autocomplete="email" required />
          </div>
        </div>
        <div class="field">
          <label for="b-company">{b.fields.company} <span>({b.fields.optional})</span></label>
          <input id="b-company" name="company" type="text" autocomplete="organization" />
        </div>
        <div class="two">
          <div class="field">
            <label for="b-need">{b.fields.need}</label>
            <select id="b-need" name="need" required>
              <option value="" disabled selected>{lang === 'fr' ? 'Choisir' : 'Choose'}</option>
              {b.needs.map((n) => <option value={n.v}>{n.t}</option>)}
            </select>
          </div>
          <div class="field">
            <label for="b-budget">{b.fields.budget} <span>({b.fields.optional})</span></label>
            <select id="b-budget" name="budget">
              <option value="" selected>{lang === 'fr' ? 'Choisir' : 'Choose'}</option>
              {b.budgets.map((n) => <option value={n.v}>{n.t}</option>)}
            </select>
          </div>
        </div>
        <div class="field">
          <label for="b-message">{b.fields.message} <span>({b.fields.optional})</span></label>
          <textarea id="b-message" name="message" placeholder={b.fields.messagePlaceholder}></textarea>
        </div>

        <fieldset class="mode">
          <legend>{b.mode.label}</legend>
          <label class="mode-opt">
            <input type="radio" name="mode" value="meet" checked />
            <span><b>{b.mode.meet}</b><small>{b.mode.meetNote}</small></span>
          </label>
          <label class="mode-opt">
            <input type="radio" name="mode" value="mail" />
            <span><b>{b.mode.mail}</b><small>{b.mode.mailNote}</small></span>
          </label>
        </fieldset>

        <input class="hp" type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <p class="form-msg" id="b-msg1" role="alert"></p>
        <div class="btn-row">
          <button class="btn btn-primary" type="submit" id="b-submit"><span class="arrow">{b.next}&nbsp;</span></button>
        </div>
        <p class="tz" style="margin:0">{b.privacy}</p>
      </form>

      <!-- Étape 2 : le calendrier -->
      <div id="step-2" hidden>
        <div class="notice" id="preview-note" hidden style="margin-bottom:24px">{b.preview}</div>
        <p id="loading" class="lead">{b.loading}</p>
        <p id="no-slots" class="lead" hidden>{b.noSlotsAll}</p>
        <div id="picker" class="cal-wrap" hidden>
          <div class="cal">
            <div class="cal-head">
              <button type="button" id="cal-prev" aria-label={b.cal.prev}>‹</button>
              <b id="cal-title" aria-live="polite"></b>
              <button type="button" id="cal-next" aria-label={b.cal.next}>›</button>
            </div>
            <div class="cal-week" aria-hidden="true">
              {b.weekdays.map((d) => <span>{d}</span>)}
            </div>
            <div class="cal-grid" id="cal-grid" role="group" aria-label={b.pickDay}></div>
            <p class="tz" id="cal-empty" hidden>{b.cal.noDays}</p>
          </div>
          <div class="cal-times">
            <span class="sub-label" id="times-title">{b.pickTime}</span>
            <div class="times" id="times" role="group" aria-label={b.pickTime}></div>
            <p class="tz" id="tz"></p>
          </div>
        </div>
        <div class="btn-row between">
          <button class="btn btn-ghost" type="button" id="back-2">{b.back}</button>
          <button class="btn btn-primary" type="button" id="next-2" disabled><span class="arrow">{b.recap}&nbsp;</span></button>
        </div>
      </div>

      <!-- Étape 3 : confirmation -->
      <div id="step-3" hidden>
        <h2 style="font-size:1.6rem;margin-bottom:20px">{b.recap}</h2>
        <dl class="recap" id="recap"></dl>
        <div class="notice" id="preview-note-3" hidden style="margin-bottom:20px">{b.preview}</div>
        <p class="form-msg" id="b-msg3" role="alert"></p>
        <div class="btn-row between" style="margin-top:12px">
          <button class="btn btn-ghost" type="button" id="back-3">{b.back}</button>
          <button class="btn btn-primary" type="button" id="confirm">{b.confirm}</button>
        </div>
      </div>

      <!-- Succès -->
      <div class="success" id="done" hidden tabindex="-1">
        <h2 id="done-title">{b.successTitle}</h2>
        <p id="done-text">{b.successText}</p>
        <div class="btn-row" style="margin-top:24px">
          <a class="btn btn-ghost" href={href(lang)}>{c.nav.home}</a>
        </div>
      </div>
    </div>
  </section>

  <script type="application/json" id="b-i18n" set:html={JSON.stringify(i18n)} />
</Base>

<script>
  type Slot = string; // ISO UTC
  const t = JSON.parse(document.getElementById('b-i18n')!.textContent || '{}');
  const $ = (id: string) => document.getElementById(id)!;
  const steps = [$('step-1'), $('step-2'), $('step-3')];
  const stepper = $('stepper');
  const lang = t.lang as string;
  const locale = lang === 'fr' ? 'fr-FR' : 'en-GB';
  const userTz = Intl.DateTimeFormat().resolvedOptions().timeZone;

  let preview = false;
  let slots: Slot[] = [];
  let chosen: Slot | '' = '';
  let loaded = false;
  const answers: Record<string, string> = {};

  function show(i: number) {
    steps.forEach((el, k) => (el.hidden = k !== i));
    stepper.querySelectorAll('li').forEach((li, k) => {
      li.toggleAttribute('aria-current', k === i);
      if (k === i) li.setAttribute('aria-current', 'step');
      li.classList.toggle('done', k < i);
    });
    window.scrollTo({ top: stepper.getBoundingClientRect().top + window.scrollY - 90, behavior: 'smooth' });
  }
  show(0);

  const dayKey = (iso: string) =>
    new Intl.DateTimeFormat('en-CA', { timeZone: userTz, year: 'numeric', month: '2-digit', day: '2-digit' }).format(new Date(iso));
  const fmtTime = (iso: string) =>
    new Intl.DateTimeFormat(locale, { timeZone: userTz, hour: '2-digit', minute: '2-digit' }).format(new Date(iso));
  const fmtLong = (iso: string) =>
    new Intl.DateTimeFormat(locale, { timeZone: userTz, weekday: 'long', day: 'numeric', month: 'long', hour: '2-digit', minute: '2-digit' }).format(new Date(iso));

  // ---- étape 1 : la demande
  const form = $('step-1') as HTMLFormElement;
  const submit = $('b-submit') as HTMLButtonElement;
  const modeOf = () => (form.elements.namedItem('mode') as RadioNodeList).value || 'meet';
  const setLabel = () => {
    submit.innerHTML = '';
    const sp = document.createElement('span');
    if (modeOf() === 'meet') {
      sp.className = 'arrow';
      sp.textContent = t.next + '\u00a0';
    } else sp.textContent = t.sendMail;
    submit.appendChild(sp);
  };
  form.querySelectorAll('input[name="mode"]').forEach((r) => r.addEventListener('change', setLabel));

  const emailOk = (v: string) => /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v);
  const phoneOk = (v: string) => /^[+()\d][\d\s().+\-]{5,24}$/.test(v) && v.replace(/\D/g, '').length >= 6;

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    new FormData(form).forEach((v, k) => (answers[k] = String(v).trim()));
    const m = $('b-msg1');
    m.className = 'form-msg';
    if (!answers.firstName || !answers.lastName || !emailOk(answers.email || '') || !answers.need) {
      m.textContent = t.errorFields;
      m.classList.add('err');
      return;
    }
    if (!phoneOk(answers.phone || '')) {
      m.textContent = t.errorPhone;
      m.classList.add('err');
      return;
    }
    m.textContent = '';

    if (modeOf() === 'mail') {
      submit.disabled = true;
      try {
        const res = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ ...answers, subject: t.needs[answers.need] || answers.need, lang }),
        });
        if (!res.ok) throw new Error(String(res.status));
        steps.forEach((el) => (el.hidden = true));
        stepper.hidden = true;
        $('done-title').textContent = t.mailTitle;
        $('done-text').textContent = t.mailText;
        $('done').hidden = false;
        $('done').focus();
      } catch {
        m.textContent = t.error;
        m.classList.add('err');
        submit.disabled = false;
      }
      return;
    }
    show(1);
    if (!loaded) loadSlots();
  });

  // ---- étape 2 : le calendrier
  let months: string[] = []; // 'YYYY-MM'
  let mi = 0;
  let byDay = new Map<string, Slot[]>();
  let chosenDay = '';

  async function loadSlots() {
    $('loading').hidden = false;
    $('picker').hidden = true;
    $('no-slots').hidden = true;
    try {
      const res = await fetch('/api/availability');
      const data = await res.json();
      preview = Boolean(data.preview);
      slots = Array.isArray(data.slots) ? data.slots : [];
      loaded = true;
    } catch {
      slots = [];
    }
    $('loading').hidden = true;
    $('preview-note').hidden = !preview;
    if (!slots.length) {
      $('no-slots').hidden = false;
      return;
    }
    byDay = new Map();
    slots.forEach((s) => {
      const k = dayKey(s);
      byDay.set(k, [...(byDay.get(k) || []), s]);
    });
    months = Array.from(new Set(Array.from(byDay.keys()).map((k) => k.slice(0, 7)))).sort();
    mi = 0;
    chosenDay = '';
    chosen = '';
    ($('next-2') as HTMLButtonElement).disabled = true;
    $('times').innerHTML = '';
    $('picker').hidden = false;
    $('tz').textContent = `${t.tz} ${userTz.replace('_', ' ')}`;
    renderMonth();
  }

  function renderMonth() {
    const [y, mo] = months[mi].split('-').map(Number);
    const first = new Date(Date.UTC(y, mo - 1, 1, 12));
    const days = new Date(Date.UTC(y, mo, 0, 12)).getUTCDate();
    const offset = (first.getUTCDay() + 6) % 7; // lundi en premier
    $('cal-title').textContent = new Intl.DateTimeFormat(locale, { timeZone: 'UTC', month: 'long', year: 'numeric' }).format(first);
    ($('cal-prev') as HTMLButtonElement).disabled = mi === 0;
    ($('cal-next') as HTMLButtonElement).disabled = mi === months.length - 1;
    const grid = $('cal-grid');
    grid.innerHTML = '';
    for (let i = 0; i < offset; i++) grid.appendChild(document.createElement('span'));
    for (let d = 1; d <= days; d++) {
      const key = `${months[mi]}-${String(d).padStart(2, '0')}`;
      const b = document.createElement('button');
      b.type = 'button';
      b.className = 'cal-day';
      b.textContent = String(d);
      const free = byDay.has(key);
      b.disabled = !free;
      if (free) {
        b.classList.add('free');
        b.setAttribute('aria-pressed', String(key === chosenDay));
        b.setAttribute(
          'aria-label',
          new Intl.DateTimeFormat(locale, { timeZone: 'UTC', weekday: 'long', day: 'numeric', month: 'long' }).format(new Date(Date.UTC(y, mo - 1, d, 12))),
        );
        b.addEventListener('click', () => pickDay(key));
      }
      grid.appendChild(b);
    }
  }

  function pickDay(key: string) {
    chosenDay = key;
    chosen = '';
    ($('next-2') as HTMLButtonElement).disabled = true;
    $('cal-grid').querySelectorAll('.cal-day.free').forEach((x) => {
      x.setAttribute('aria-pressed', String(x.textContent === String(Number(key.slice(8))) && key.startsWith(months[mi])));
    });
    const list = byDay.get(key) || [];
    const [y, mo, d] = key.split('-').map(Number);
    $('times-title').textContent = new Intl.DateTimeFormat(locale, { timeZone: 'UTC', weekday: 'long', day: 'numeric', month: 'long' }).format(new Date(Date.UTC(y, mo - 1, d, 12)));
    const box = $('times');
    box.innerHTML = '';
    if (!list.length) {
      box.textContent = t.noSlotsDay;
      return;
    }
    list.forEach((s) => {
      const b = document.createElement('button');
      b.type = 'button';
      b.className = 'time';
      b.setAttribute('aria-pressed', 'false');
      b.textContent = fmtTime(s);
      b.addEventListener('click', () => {
        chosen = s;
        box.querySelectorAll('.time').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
        ($('next-2') as HTMLButtonElement).disabled = false;
      });
      box.appendChild(b);
    });
  }

  $('cal-prev').addEventListener('click', () => {
    if (mi > 0) {
      mi--;
      renderMonth();
    }
  });
  $('cal-next').addEventListener('click', () => {
    if (mi < months.length - 1) {
      mi++;
      renderMonth();
    }
  });
  $('back-2').addEventListener('click', () => show(0));
  $('next-2').addEventListener('click', () => {
    if (!chosen) return;
    renderRecap();
    show(2);
  });

  // ---- étape 3 : confirmation
  function renderRecap() {
    const rows: [string, string][] = [
      [t.fields.name, `${answers.firstName} ${answers.lastName}`],
      [t.fields.phone, answers.phone],
      [t.fields.email, answers.email],
      ...(answers.company ? ([[t.fields.company, answers.company]] as [string, string][]) : []),
      [t.fields.need, t.needs[answers.need] || answers.need],
      ...(answers.budget ? ([[t.fields.budget, t.budgets[answers.budget] || answers.budget]] as [string, string][]) : []),
      ...(answers.message ? ([[t.fields.message, answers.message]] as [string, string][]) : []),
      ['', `${fmtLong(chosen as string)} \u00b7 ${t.duration} min`],
    ];
    const dl = $('recap');
    dl.innerHTML = '';
    rows.forEach(([k, v]) => {
      const d = document.createElement('div');
      const dt = document.createElement('dt');
      const dd = document.createElement('dd');
      dt.textContent = k;
      dd.textContent = v;
      d.append(dt, dd);
      dl.appendChild(d);
    });
    $('preview-note-3').hidden = !preview;
  }

  $('back-3').addEventListener('click', () => show(1));
  $('confirm').addEventListener('click', async () => {
    const btn = $('confirm') as HTMLButtonElement;
    const m = $('b-msg3');
    m.className = 'form-msg';
    m.textContent = '';
    btn.disabled = true;
    const label = btn.textContent;
    btn.textContent = t.sending;
    try {
      const res = await fetch('/api/book', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ ...answers, slot: chosen, lang, tz: userTz }),
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(data?.error || String(res.status));
      steps.forEach((el) => (el.hidden = true));
      stepper.hidden = true;
      $('done').hidden = false;
      if (data.preview) $('done-text').textContent = t.successPreview;
      $('done').focus();
      window.scrollTo({ top: $('done').getBoundingClientRect().top + window.scrollY - 120, behavior: 'smooth' });
    } catch {
      m.textContent = t.error;
      m.classList.add('err');
      btn.disabled = false;
      btn.textContent = label;
      // le créneau a peut-être été pris : on recharge les disponibilités
      loaded = false;
    }
  });
</script>
