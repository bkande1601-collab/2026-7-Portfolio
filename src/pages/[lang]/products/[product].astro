---
import BuyButton from '../../../components/BuyButton.astro';
import Base from '../../../layouts/Base.astro';
import CtaBand from '../../../components/CtaBand.astro';
import Crumb from '../../../components/Crumb.astro';
import { t, em, href, langs, type Lang } from '../../../content';
import { formatPrice, prices, stripeLinks, type PriceKey } from '../../../config/site';
import { promptTypes, PICK } from '../../../config/masterPrompts';
import { promptPreviews } from '../../../config/promptPreviews';

export function getStaticPaths() {
  const keys = ['diagnostic', 'prompt'];
  return langs.flatMap((lang) => keys.map((product) => ({ params: { lang, product } })));
}
const lang = Astro.params.lang as Lang;
const key = Astro.params.product as 'diagnostic' | 'prompt';
const c = t(lang);
const p = c.products;
const it = p.items.find((x) => x.key === key)!;
const price = formatPrice(key as PriceKey, lang);
const link = stripeLinks[key];
const other = p.items.find((x) => x.key !== key)!;
const r = p.report;
const d = p.promptDemo;
const score = Math.round((r.axes.reduce((a, x) => a + x.s, 0) / r.axes.length) * 10);
const C = 2 * Math.PI * 52;
const origin = Astro.site ? Astro.site.origin : '';
const productLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: it.name,
  description: it.line,
  image: `${origin}/og/default.png`,
  brand: { '@type': 'Brand', name: 'Binta Kande' },
  offers: { '@type': 'Offer', url: `${origin}${href(lang, `products/${key}`)}`, priceCurrency: 'EUR', price: String(prices[key as 'diagnostic' | 'prompt'].amount), availability: 'https://schema.org/InStock', itemCondition: 'https://schema.org/NewCondition' },
};
const fr = lang === 'fr';
const checkoutOn = import.meta.env.PUBLIC_CHECKOUT === 'on';
const PT = fr
  ? {
      denseKicker: 'Ce que vous recevez vraiment',
      denseTitle: 'Un master prompt, ce n’est pas une phrase. C’est un dossier de 15 sections.',
      denseLead: 'Chaque master prompt fait plus de 4 000 mots, soit plusieurs pages de PDF denses, écrites pour votre activité, vos clients et votre voix. Vous le collez une fois : l’IA travaille ensuite comme un expert qui vous connaît déjà.',
      stats: [['4 000+', 'mots par master prompt'], ['15', 'sections, du rôle au contrôle qualité'], ['2', 'PDF prêts à copier-coller'], ['+ bonus', 'analyse de votre site et de votre LinkedIn']],
      file: 'master-prompt-vente.txt',
      more: 'Et 4 600 mots de plus : méthode d’expert, 11 gabarits, 6 exemples complets, règles, contrôle qualité…',
      sectionsTitle: 'Les 15 sections de chaque master prompt',
      sections: ['Comment lire le document', 'Rôle et expertise', 'Mission et objectifs', 'Contexte de votre entreprise', 'Vos clients et leurs objections', 'Identité de marque et voix', 'Méthode d’expert', 'Bibliothèque de tâches', '8 à 12 gabarits prêts à l’emploi', 'Au moins 5 exemples complets', 'Règles et limites', 'Questions préalables', 'Format de sortie', 'Contrôle qualité', 'Mémoire et itération'],
      chooseKicker: 'Étape 1 sur 3',
      chooseTitle: 'Choisissez vos 2 master prompts',
      chooseLead: 'Sept spécialités. Vous en prenez deux, pour le prix d’un seul produit. Ouvrez « Voir un extrait » pour lire un vrai passage.',
      steps: ['Vous choisissez 2 master prompts', 'Vous payez en sécurité', 'Vous répondez au questionnaire, puis vous recevez vos 2 PDF'],
      extract: 'Voir un extrait',
      chosen: 'choisi',
      pick: 'Choisissez 2 master prompts pour continuer',
      go: 'Je valide mon choix et je paie',
      soon: 'Bientôt disponible',
      err: 'Le paiement est indisponible pour le moment. Réessayez dans un instant.',
      yourChoice: 'Votre choix :',
      none: 'aucun pour l’instant',
    }
  : {
      denseKicker: 'What you actually receive',
      denseTitle: 'A master prompt is not one sentence. It is a 15-section file.',
      denseLead: 'Each master prompt runs over 4,000 words, several dense PDF pages written for your business, your customers and your voice. You paste it once: the AI then works like an expert who already knows you.',
      stats: [['4,000+', 'words per master prompt'], ['15', 'sections, from role to quality check'], ['2', 'PDFs ready to copy and paste'], ['+ bonus', 'review of your website and LinkedIn']],
      file: 'master-prompt-sales.txt',
      more: 'And 4,600 more words: expert method, 11 templates, 6 full examples, rules, quality check…',
      sectionsTitle: 'The 15 sections of every master prompt',
      sections: ['How to read the document', 'Role and expertise', 'Mission and goals', 'Your business context', 'Your customers and their objections', 'Brand identity and voice', 'Expert method', 'Task library', '8 to 12 ready-to-use templates', 'At least 5 complete examples', 'Rules and limits', 'Questions to ask first', 'Output format', 'Quality check', 'Memory and iteration'],
      chooseKicker: 'Step 1 of 3',
      chooseTitle: 'Choose your 2 master prompts',
      chooseLead: 'Seven specialities. You take two, for the price of a single product. Open “See an excerpt” to read a real passage.',
      steps: ['You choose 2 master prompts', 'You pay securely', 'You answer the questionnaire, then receive your 2 PDFs'],
      extract: 'See an excerpt',
      chosen: 'chosen',
      pick: 'Choose 2 master prompts to continue',
      go: 'Confirm my choice and pay',
      soon: 'Coming soon',
      err: 'Payment is unavailable right now. Please try again in a moment.',
      yourChoice: 'Your choice:',
      none: 'none yet',
    };
const ice = (x: { i: number; c: number; f: number }) => ((x.i + x.c + x.f) / 3).toFixed(1).replace('.', lang === 'fr' ? ',' : '.');
---

<Base buybar buybarOnly={key} lang={lang} page={`products/${key}`} title={it.name} description={it.line} jsonLd={[productLd]}>
  <section class="page-hero has-photo">
    <div class="wrap hero-split">
      <div class="hero-text">
      <Crumb lang={lang} parent="products" label={c.nav.products} />
      <span class="kicker" style="display:flex">{p.hero.kicker}</span>
      <h1>{it.name}</h1>
      <p class="lead">{it.line}</p>
      <div class="product-buy" style="margin-top:28px">
        <span class="product-price" style="color:var(--violet-deep)">{price.amount}</span>
        <BuyButton product={key} lang={lang} label={it.cta} soon={p.soon} link={link} />
      </div>
      </div>
      <img class="hero-photo" src="/photos/binta-accueil-violet.webp" alt="Binta Kande en haut violet, les bras croisés" width="1108" height="1313" />
    </div>
  </section>

  {key === 'prompt' && (
    <>
      <section class="pp-dense">
        <div class="wrap">
          <div class="section-head reveal">
            <span class="kicker">{PT.denseKicker}</span>
            <h2>{PT.denseTitle}</h2>
            <p class="lead">{PT.denseLead}</p>
          </div>
          <div class="pp-stats reveal">
            {PT.stats.map(([n, l]) => <div><strong>{n}</strong><span>{l}</span></div>)}
          </div>
          <div class="pp-win reveal" aria-label={PT.file}>
            <div class="pp-bar"><i></i><i></i><i></i><span>{PT.file}</span></div>
            <pre class="pp-code" set:html={promptPreviews.sales[lang].replace(/&/g, '&amp;').replace(/</g, '&lt;').split('\n').filter((l) => !l.startsWith('…')).map((l, n) => `<span class="ln">${n + 1}</span>${l.startsWith('##') ? `<b>${l}</b>` : l.startsWith('…') ? `<em>${l}</em>` : l}`).join('\n')}></pre>
            <p class="pp-more">{PT.more}</p>
          </div>
          <h3 class="pp-h3 reveal">{PT.sectionsTitle}</h3>
          <ol class="pp-sections reveal">
            {PT.sections.map((x) => <li>{x}</li>)}
          </ol>
        </div>
      </section>

      <section id="choisir" class="pp-choose">
        <div class="wrap">
          <div class="section-head reveal">
            <span class="kicker">{PT.chooseKicker}</span>
            <h2>{PT.chooseTitle}</h2>
            <p class="lead">{PT.chooseLead}</p>
            <ol class="pp-flow">{PT.steps.map((x, n) => <li class={n === 0 ? 'on' : ''}><b>{n + 1}</b>{x}</li>)}</ol>
          </div>
          <div class="pp-grid" id="pp-grid" data-pick={PICK}>
            {promptTypes.map((x) => (
              <div class="pp-card">
                <label>
                  <input type="checkbox" name="pp" value={x.id} />
                  <span class="pp-box" aria-hidden="true"></span>
                  <span class="pp-card-b"><strong>{x.name[lang]}</strong><em>{x.tagline[lang]}</em><small>{x.gets[lang]}</small></span>
                </label>
                <details>
                  <summary>{PT.extract}</summary>
                  <pre class="pp-code pp-mini" set:html={promptPreviews[x.id][lang].replace(/&/g, '&amp;').replace(/</g, '&lt;').split('\n').map((l) => (l.startsWith('##') ? `<b>${l}</b>` : l.startsWith('…') ? `<em>${l}</em>` : l)).join('\n')}></pre>
                </details>
              </div>
            ))}
          </div>
          <div class="pp-cta" id="pp-cta" data-checkout={checkoutOn ? 'on' : ''} data-lang={lang} data-err={PT.err} data-pick-msg={PT.pick} data-none={PT.none} data-names={JSON.stringify(Object.fromEntries(promptTypes.map((x) => [x.id, x.name[lang]])))}>
            <p><span>{PT.yourChoice}</span> <b id="pp-sel">{PT.none}</b> · <span id="pp-n">0</span>/{PICK} {PT.chosen}</p>
            <button class="btn btn-primary" type="button" id="pp-go" disabled data-go={PT.go} data-soon={PT.soon}>{PT.pick}</button>
          </div>
        </div>
      </section>
    </>
  )}

  <section style="padding-top:clamp(32px,5vw,64px)">
    <div class="wrap split" style="align-items:start">
      <div class="reveal">
        <span class="kicker">{p.forWhoLabel}</span>
        <p class="lead" style="margin-top:0">{it.forWho}</p>
        <span class="kicker" style="margin-top:36px;display:flex">{p.asksLabel}</span>
        <ul class="checks">
          {it.asks.map((x) => <li>{x}</li>)}
        </ul>
      </div>
      <div class="reveal">
        <span class="kicker">{p.getsLabel}</span>
        <ol class="gets">
          {it.gets.map((g, i) => (
            <li>
              <span class="gets-n">0{i + 1}</span>
              <span class="gets-t">{g.t}</span>
              <span class="gets-d">{g.d}</span>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- Un exemple -->
  <section style="background:var(--bg-2);border-block:1px solid var(--line)">
    <div class="wrap">
      <div class="section-head reveal">
        <span class="kicker">{it.example.title}</span>
        <h2>{it.example.who}</h2>
        <p class="lead">{it.example.problem}</p>
      </div>
      {key === 'diagnostic' ? (
        <div class="rep reveal">
          <div class="rep-top">
            <div class="rep-score">
              <svg viewBox="0 0 120 120" width="150" height="150" role="img" aria-label={`${r.scoreLabel} ${score} ${r.outOf}`}>
                <circle cx="60" cy="60" r="52" fill="none" stroke="var(--lilas)" stroke-width="12" />
                <circle cx="60" cy="60" r="52" fill="none" stroke="var(--rouille)" stroke-width="12" stroke-linecap="round" stroke-dasharray={`${(C * score) / 100} ${C}`} transform="rotate(-90 60 60)" />
                <text x="60" y="62" text-anchor="middle" font-size="34" font-weight="800" fill="var(--violet-deep)">{score}</text>
                <text x="60" y="82" text-anchor="middle" font-size="11" fill="var(--muted)">{r.outOf}</text>
              </svg>
              <b>{r.scoreLabel}</b>
            </div>
            <div class="rep-axes">
              <span class="rep-h">{r.axesLabel}</span>
              {r.axes.map((a) => (
                <div class="rep-bar"><span>{a.t}</span><i><u style={`width:${a.s * 10}%`}></u></i><em>{a.s}/10</em></div>
              ))}
            </div>
          </div>

          <div class="rep-box rep-expert">
            <span class="rep-h">{r.expertLabel}</span>
            <div class="rep-3">
              {r.expert.map((x) => <div><b>{x.t}</b><p>{x.d}</p></div>)}
            </div>
          </div>

          <div class="rep-box">
            <span class="rep-h">{r.letterLabel}</span>
            <p style="font-style:italic;margin:0">{r.letter}</p>
          </div>

          <div class="rep-box">
            <span class="rep-h">{r.funnelLabel}</span>
            <div class="rep-funnel">
              {r.funnel.map((x, n) => (
                <div class={`fn fn-${x.st}`} style={`--w:${100 - n * 6}%`}>
                  <b>{x.t}</b><span>{x.d}</span><em>{r.funnelState[x.st as 'ok' | 'mid' | 'low']}</em>
                </div>
              ))}
            </div>
          </div>

          <div class="rep-box">
            <span class="rep-h">{r.swotLabel}</span>
            <div class="rep-swot">
              {r.swot.map((q, n) => (
                <div class={`sw sw-${n}`}><b>{q.t}</b><ul>{q.items.map((i) => <li>{i}</li>)}</ul></div>
              ))}
            </div>
          </div>

          <div class="rep-box">
            <span class="rep-h">{r.iceLabel}</span>
            <div class="rep-ice">
              {r.ice.map((x, n) => (
                <div class="ic">
                  <div class="ic-head"><span class="ic-n">0{n + 1}</span><b>{x.t}</b><strong>{ice(x)}</strong></div>
                  <div class="ic-bars">
                    {[[r.iceCols[0], x.i], [r.iceCols[1], x.c], [r.iceCols[2], x.f]].map(([l, v]) => (
                      <div class="rep-bar"><span>{l}</span><i><u style={`width:${Number(v) * 10}%`}></u></i><em>{v}/10</em></div>
                    ))}
                  </div>
                  <p>{x.effect} · {x.delay}</p>
                </div>
              ))}
            </div>
          </div>

          <div class="rep-duo">
            <div class="rep-box rep-pot">
              <span class="rep-h">{r.potentialLabel}</span>
              <div class="pot">
                <div><strong>{r.hours}</strong><span>{r.hoursLabel}</span></div>
                <div><strong>{r.revenue}</strong><span>{r.revenueLabel}</span></div>
              </div>
              <p>{r.potentialNote}</p>
            </div>
            <div class="rep-box">
              <span class="rep-h">{r.kpiLabel}</span>
              <ul class="kpi">
                {r.kpi.map((k) => <li><span>{k.t}</span><b>{k.v}</b></li>)}
              </ul>
            </div>
          </div>

          <div class="rep-box">
            <span class="rep-h">{r.ideasLabel}</span>
            <div class="rep-plan">
              {r.ideas.map((x) => (
                <div><b>{x.t}</b><ul><li>{x.b}</li><li>{x.d}</li></ul></div>
              ))}
            </div>
          </div>

          <div class="rep-box">
            <span class="rep-h">{r.delegLabel}</span>
            <ul class="kpi">
              {r.deleg.map((x) => <li class="col"><b>{x.t} · {x.o}</b><span>{x.c} · {x.g}</span></li>)}
            </ul>
          </div>

          <div class="rep-box">
            <span class="rep-h">{r.planLabel}</span>
            <div class="rep-plan">
              {r.plan.map((x) => (
                <div><b>{x.p}</b><ul>{x.a.map((i) => <li>{i}</li>)}</ul><p style="font-size:.9rem;margin:8px 0 0"><b>{x.done}</b></p></div>
              ))}
            </div>
          </div>
        </div>
      ) : (
        <div class="rep reveal">
          <div class="rep-box pdoc">
            <div class="pdoc-head"><b>{d.docLabel}</b><span>{d.docMeta}</span></div>
            {d.sections.map((x) => <p class="pdoc-s"><em>{x.t}</em>{x.d}</p>)}
          </div>

          <div class="rep-duo">
            <div class="rep-box">
              <span class="rep-h">{d.toneLabel}</span>
              {d.tone.map((x) => (
                <div class="tn"><span>{x.l}</span><i><u style={`left:${x.v}%`}></u></i><span>{x.r}</span></div>
              ))}
            </div>
            <div class="rep-box">
              <span class="rep-h">{d.wordsLabel}</span>
              <div class="words">
                {d.use.map((w) => <span class="w-ok">{w}</span>)}
                {d.avoid.map((w) => <span class="w-no">{w}</span>)}
              </div>
            </div>
          </div>

          <div class="rep-box">
            <span class="rep-h">{d.cmpLabel}</span>
            <p class="cmp-q">{d.cmpQ}</p>
            <div class="cmp">
              <div class="cmp-b"><b>{d.before.t}</b><p>{d.before.d}</p></div>
              <div class="cmp-a"><b>{d.after.t}</b><p>{d.after.d}</p></div>
            </div>
          </div>

          <div class="rep-duo">
            <div class="rep-box">
              <span class="rep-h">{d.checkLabel}</span>
              <ul class="kpi">
                {d.checks.map((k) => <li><span>{k.t}</span><b><span class="tick">✓</span> {k.d}</b></li>)}
              </ul>
            </div>
            <div class="rep-box">
              <span class="rep-h">{d.casesLabel}</span>
              <ul class="kpi">
                {d.cases.map((k) => <li class="col"><b>{k.t}</b><span>{k.d}</span></li>)}
              </ul>
            </div>
          </div>

          <div class="rep-box rep-expert">
            <span class="rep-h">{d.howLabel}</span>
            <div class="rep-3">
              {d.how.map((x, n) => <div><b>0{n + 1}</b><p>{x}</p></div>)}
            </div>
          </div>
        </div>
      )}
      <p class="note reveal">{key === 'diagnostic' ? `${r.pdfNote} ` : `${d.pdfNote} `}{it.example.note}</p>
      {'replyNote' in it && it.replyNote && <p class="note reveal"><b>{it.replyNote}</b></p>}
    </div>
  </section>

  <section class="band-marine">
    <div class="wrap">
      <div class="section-head reveal">
        <span class="kicker">{p.how.kicker}</span>
        <h2>{p.how.title}</h2>
      </div>
      <div class="steps-line three reveal">
        {p.how.steps.map((s) => <div><b>{s.t}</b><span>{s.d}</span></div>)}
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="section-head reveal">
        <span class="kicker">{p.trustKicker}</span>
      </div>
      <div class="also reveal">
        {p.trust.map((x) => <div><b>{x.t}</b><span>{x.d}</span></div>)}
      </div>
      <p class="sublinks reveal" style="margin-top:36px">
        <a class="textlink" href={href(lang, other.slug)}><span class="arrow">{other.name}&nbsp;</span></a>
      </p>
    </div>
  </section>

  <section style="padding-top:0">
    <div class="wrap split">
      <div class="reveal">
        <span class="kicker">{p.next.kicker}</span>
        <h2 set:html={em(p.next.title)} />
        <p class="lead">{p.next.text}</p>
        <div class="btn-row" style="margin-top:28px">
          <a class="btn btn-primary" href={href(lang, 'book')}>{p.next.linkCall}</a>
          <a class="btn btn-ghost" href={href(lang, 'offers')}>{p.next.linkOffers}</a>
        </div>
      </div>
    </div>
  </section>

  <CtaBand lang={lang} title={p.finalTitle} text={p.finalText} />

  <script>
    const grid = document.getElementById('pp-grid');
    const cta = document.getElementById('pp-cta');
    const go = document.getElementById('pp-go') as HTMLButtonElement | null;
    if (grid && cta && go) {
      const max = Number(grid.dataset.pick || 2);
      const boxes = Array.from(grid.querySelectorAll<HTMLInputElement>('input[name=pp]'));
      const names = JSON.parse(cta.dataset.names || '{}') as Record<string, string>;
      const on = () => boxes.filter((b) => b.checked).map((b) => b.value);
      const sync = () => {
        const sel = on();
        boxes.forEach((b) => { b.disabled = !b.checked && sel.length >= max; b.closest('.pp-card')?.classList.toggle('is-on', b.checked); });
        document.getElementById('pp-n')!.textContent = String(sel.length);
        document.getElementById('pp-sel')!.textContent = sel.length ? sel.map((i) => names[i]).join(' + ') : (cta.dataset.none || '');
        const ready = sel.length === max;
        go.disabled = !ready || (!cta.dataset.checkout);
        go.textContent = !cta.dataset.checkout ? (go.dataset.soon || '') : ready ? (go.dataset.go || '') : (cta.dataset.pickMsg || '');
        cta.classList.toggle('ready', ready);
        try { sessionStorage.setItem('pp-pick', sel.join(',')); } catch {}
      };
      try { (sessionStorage.getItem('pp-pick') || '').split(',').forEach((v) => { const b = boxes.find((x) => x.value === v); if (b && boxes.filter((x) => x.checked).length < max) b.checked = true; }); } catch {}
      boxes.forEach((b) => b.addEventListener('change', sync));
      sync();
      go.addEventListener('click', async () => {
        const sel = on();
        if (sel.length !== max) return;
        const label = go.textContent;
        go.disabled = true;
        try {
          const res = await fetch('/api/checkout', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ product: 'prompt', lang: cta.dataset.lang, types: sel }) });
          const data = await res.json();
          if (!res.ok || !data.url) throw new Error('checkout');
          location.assign(data.url);
        } catch {
          go.disabled = false;
          go.textContent = label;
          alert(cta.dataset.err);
        }
      });
    }
  </script>

  <style is:global>
    .pp-dense { background: var(--violet-deep); color: #fbf7ee; }
    .pp-dense h2, .pp-dense .kicker { color: #fbf7ee; }
    .pp-dense .kicker { color: #c6b8e4; }
    .pp-dense .lead { color: #e4d9f1; }
    .pp-stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; margin: 8px 0 34px; }
    .pp-stats div { background: rgba(255,255,255,.07); border: 1px solid rgba(198,184,228,.3); border-radius: 16px; padding: 18px; }
    .pp-stats strong { display: block; font-family: var(--font-head); font-size: clamp(1.8rem, 3.4vw, 2.6rem); line-height: 1; color: #fff; }
    .pp-stats span { display: block; margin-top: 8px; color: #c6b8e4; font-size: .92rem; }
    .pp-win { background: #1b1230; border-radius: 16px; overflow: hidden; border: 1px solid rgba(198,184,228,.25); box-shadow: 0 22px 60px rgba(0,0,0,.35); }
    .pp-bar { display: flex; align-items: center; gap: 7px; padding: 12px 16px; background: #261a42; }
    .pp-bar i { width: 11px; height: 11px; border-radius: 50%; background: #6a56a0; }
    .pp-bar i:nth-child(1) { background: #be5626; }
    .pp-bar span { margin-left: 10px; font: 600 .82rem ui-monospace, SFMono-Regular, Menlo, monospace; color: #c6b8e4; }
    .pp-code { margin: 0; padding: 18px 20px; font: .86rem/1.75 ui-monospace, SFMono-Regular, Menlo, monospace; color: #e9e1f7; white-space: pre-wrap; overflow-wrap: anywhere; background: transparent; }
    .pp-code b { color: #f0b48f; font-weight: 700; }
