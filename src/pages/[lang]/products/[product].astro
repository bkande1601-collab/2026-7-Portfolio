---
import BuyButton from '../../../components/BuyButton.astro';
import Base from '../../../layouts/Base.astro';
import CtaBand from '../../../components/CtaBand.astro';
import Crumb from '../../../components/Crumb.astro';
import { t, em, href, langs, type Lang } from '../../../content';
import { formatPrice, stripeLinks, type PriceKey } from '../../../config/site';

export function getStaticPaths() {
  const keys = ['diagnostic', 'prompt'];
  return langs.flatMap((lang) => keys.map((product) => ({ params: { lang, product } })));
}
const lang = Astro.params.lang as Lang;
const key = Astro.params.product as 'diagnostic' | 'prompt';
const c = t(lang);
const p = c.products;
const it = p.items.find((x) => x.key === key)!;
const price = formatPrice(key as PriceKey, lang);
const link = stripeLinks[key];
const other = p.items.find((x) => x.key !== key)!;
const r = p.report;
const score = Math.round((r.axes.reduce((a, x) => a + x.s, 0) / r.axes.length) * 10);
const C = 2 * Math.PI * 52;
const ice = (x: { i: number; c: number; f: number }) => ((x.i + x.c + x.f) / 3).toFixed(1).replace('.', lang === 'fr' ? ',' : '.');
---

<Base buybar buybarOnly={key} lang={lang} page={`products/${key}`} title={it.name} description={it.line}>
  <section class="page-hero has-photo">
    <div class="wrap hero-split">
      <div class="hero-text">
      <Crumb lang={lang} parent="products" label={c.nav.products} />
      <span class="kicker" style="display:flex">{p.hero.kicker}</span>
      <h1>{it.name}</h1>
      <p class="lead">{it.line}</p>
      <div class="product-buy" style="margin-top:28px">
        <span class="product-price" style="color:var(--violet-deep)">{price.amount}</span>
        <BuyButton product={key} lang={lang} label={it.cta} soon={p.soon} link={link} />
      </div>
      </div>
      <img class="hero-photo" src="/photos/binta-accueil-violet.webp" alt="Binta Kande en haut violet, les bras croisés" width="1108" height="1313" />
    </div>
  </section>

  <section style="padding-top:clamp(32px,5vw,64px)">
    <div class="wrap split" style="align-items:start">
      <div class="reveal">
        <span class="kicker">{p.forWhoLabel}</span>
        <p class="lead" style="margin-top:0">{it.forWho}</p>
        <span class="kicker" style="margin-top:36px;display:flex">{p.asksLabel}</span>
        <ul class="checks">
          {it.asks.map((x) => <li>{x}</li>)}
        </ul>
      </div>
      <div class="reveal">
        <span class="kicker">{p.getsLabel}</span>
        <ol class="gets">
          {it.gets.map((g, i) => (
            <li>
              <span class="gets-n">0{i + 1}</span>
              <span class="gets-t">{g.t}</span>
              <span class="gets-d">{g.d}</span>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- Un exemple -->
  <section style="background:var(--bg-2);border-block:1px solid var(--line)">
    <div class="wrap">
      <div class="section-head reveal">
        <span class="kicker">{it.example.title}</span>
        <h2>{it.example.who}</h2>
        <p class="lead">{it.example.problem}</p>
      </div>
      {key === 'diagnostic' ? (
        <div class="rep reveal">
          <div class="rep-top">
            <div class="rep-score">
              <svg viewBox="0 0 120 120" width="150" height="150" role="img" aria-label={`${r.scoreLabel} ${score} ${r.outOf}`}>
                <circle cx="60" cy="60" r="52" fill="none" stroke="var(--lilas)" stroke-width="12" />
                <circle cx="60" cy="60" r="52" fill="none" stroke="var(--rouille)" stroke-width="12" stroke-linecap="round" stroke-dasharray={`${(C * score) / 100} ${C}`} transform="rotate(-90 60 60)" />
                <text x="60" y="62" text-anchor="middle" font-size="34" font-weight="800" fill="var(--violet-deep)">{score}</text>
                <text x="60" y="82" text-anchor="middle" font-size="11" fill="var(--muted)">{r.outOf}</text>
              </svg>
              <b>{r.scoreLabel}</b>
            </div>
            <div class="rep-axes">
              <span class="rep-h">{r.axesLabel}</span>
              {r.axes.map((a) => (
                <div class="rep-bar"><span>{a.t}</span><i><u style={`width:${a.s * 10}%`}></u></i><em>{a.s}/10</em></div>
              ))}
            </div>
          </div>

          <div class="rep-box rep-expert">
            <span class="rep-h">{r.expertLabel}</span>
            <div class="rep-3">
              {r.expert.map((x) => <div><b>{x.t}</b><p>{x.d}</p></div>)}
            </div>
          </div>

          <div class="rep-box">
            <span class="rep-h">{r.funnelLabel}</span>
            <div class="rep-funnel">
              {r.funnel.map((x, n) => (
                <div class={`fn fn-${x.st}`} style={`--w:${100 - n * 6}%`}>
                  <b>{x.t}</b><span>{x.d}</span><em>{r.funnelState[x.st as 'ok' | 'mid' | 'low']}</em>
                </div>
              ))}
            </div>
          </div>

          <div class="rep-box">
            <span class="rep-h">{r.swotLabel}</span>
            <div class="rep-swot">
              {r.swot.map((q, n) => (
                <div class={`sw sw-${n}`}><b>{q.t}</b><ul>{q.items.map((i) => <li>{i}</li>)}</ul></div>
              ))}
            </div>
          </div>

          <div class="rep-box">
            <span class="rep-h">{r.iceLabel}</span>
            <div class="rep-ice">
              {r.ice.map((x, n) => (
                <div class="ic">
                  <div class="ic-head"><span class="ic-n">0{n + 1}</span><b>{x.t}</b><strong>{ice(x)}</strong></div>
                  <div class="ic-bars">
                    {[[r.iceCols[0], x.i], [r.iceCols[1], x.c], [r.iceCols[2], x.f]].map(([l, v]) => (
                      <div class="rep-bar"><span>{l}</span><i><u style={`width:${Number(v) * 10}%`}></u></i><em>{v}/10</em></div>
                    ))}
                  </div>
                  <p>{x.effect} · {x.delay}</p>
                </div>
              ))}
            </div>
          </div>

          <div class="rep-duo">
            <div class="rep-box rep-pot">
              <span class="rep-h">{r.potentialLabel}</span>
              <div class="pot">
                <div><strong>{r.hours}</strong><span>{r.hoursLabel}</span></div>
                <div><strong>{r.revenue}</strong><span>{r.revenueLabel}</span></div>
              </div>
              <p>{r.potentialNote}</p>
            </div>
            <div class="rep-box">
              <span class="rep-h">{r.kpiLabel}</span>
              <ul class="kpi">
                {r.kpi.map((k) => <li><span>{k.t}</span><b>{k.v}</b></li>)}
              </ul>
            </div>
          </div>

          <div class="rep-box">
            <span class="rep-h">{r.planLabel}</span>
            <div class="rep-plan">
              {r.plan.map((x) => (
                <div><b>{x.p}</b><ul>{x.a.map((i) => <li>{i}</li>)}</ul></div>
              ))}
            </div>
          </div>
        </div>
      ) : (
        <div class="example reveal">
          {it.example.result.map((x, i) => (
            <div class="example-card">
              <span class="example-n">0{i + 1}</span>
              <b>{x.t}</b>
              <p>{x.d}</p>
            </div>
          ))}
        </div>
      )}
      <p class="note reveal">{key === 'diagnostic' ? `${r.pdfNote} ` : ''}{it.example.note}</p>
    </div>
  </section>

  <section class="band-marine">
    <div class="wrap">
      <div class="section-head reveal">
        <span class="kicker">{p.how.kicker}</span>
        <h2>{p.how.title}</h2>
      </div>
      <div class="steps-line three reveal">
        {p.how.steps.map((s) => <div><b>{s.t}</b><span>{s.d}</span></div>)}
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="section-head reveal">
        <span class="kicker">{p.trustKicker}</span>
      </div>
      <div class="also reveal">
        {p.trust.map((x) => <div><b>{x.t}</b><span>{x.d}</span></div>)}
      </div>
      <p class="sublinks reveal" style="margin-top:36px">
        <a class="textlink" href={href(lang, other.slug)}><span class="arrow">{other.name}&nbsp;</span></a>
      </p>
    </div>
  </section>

  <section style="padding-top:0">
    <div class="wrap split">
      <div class="reveal">
        <span class="kicker">{p.next.kicker}</span>
        <h2 set:html={em(p.next.title)} />
        <p class="lead">{p.next.text}</p>
        <div class="btn-row" style="margin-top:28px">
          <a class="btn btn-primary" href={href(lang, 'book')}>{p.next.linkCall}</a>
          <a class="btn btn-ghost" href={href(lang, 'offers')}>{p.next.linkOffers}</a>
        </div>
      </div>
    </div>
  </section>

  <CtaBand lang={lang} title={p.finalTitle} text={p.finalText} />
</Base>
