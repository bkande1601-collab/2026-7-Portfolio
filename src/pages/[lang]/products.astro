---
import BuyButton from '../../components/BuyButton.astro';
import Base from '../../layouts/Base.astro';
import CtaBand from '../../components/CtaBand.astro';
import { t, em, href, langs, type Lang } from '../../content';
import { formatPrice, stripeLinks, type PriceKey } from '../../config/site';

export function getStaticPaths() {
  return langs.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const c = t(lang);
const p = c.products;
const tag = { diagnostic: { fr: 'Diagnostic', en: 'Diagnostic' }, prompt: { fr: 'Prompt', en: 'Prompt' } } as Record<string, Record<string, string>>;
const short = {
  diagnostic: { fr: 'Votre business analysé par des agents IA.', en: 'Your business analysed by AI agents.' },
  prompt: { fr: 'Un prompt long, écrit pour vous.', en: 'A long prompt, written for you.' },
} as Record<string, Record<string, string>>;
const icon = {
  diagnostic: '<svg viewBox="0 0 120 120" width="100%" height="100%" aria-hidden="true"><circle cx="60" cy="60" r="46" fill="none" stroke="currentColor" opacity=".25" stroke-width="12"/><circle cx="60" cy="60" r="46" fill="none" stroke="currentColor" stroke-width="12" stroke-linecap="round" stroke-dasharray="180 290" transform="rotate(-90 60 60)"/><text x="60" y="70" text-anchor="middle" font-size="30" font-weight="800" fill="currentColor">62</text></svg>',
  prompt: '<svg viewBox="0 0 120 120" width="100%" height="100%" aria-hidden="true"><rect x="10" y="22" width="76" height="44" rx="14" fill="currentColor" opacity=".28"/><rect x="34" y="52" width="76" height="44" rx="14" fill="currentColor"/><path d="M26 66 l-8 16 l22 -10z" fill="currentColor" opacity=".28"/></svg>',
} as Record<string, string>;
---

<Base lang={lang} page="products" title={c.nav.products} description={p.hero.sub}>
  <section class="page-hero has-photo">
    <div class="wrap hero-split">
      <div class="hero-text">
      <span class="kicker">{p.hero.kicker}</span>
      <h1 set:html={em(p.hero.title)} />
      <p class="lead">{p.hero.sub}</p>
      </div>
      <img class="hero-photo" src="/photos/binta-accueil-violet.webp" alt="Binta Kande en haut violet, les bras croisés" width="1108" height="1313" />
    </div>
  </section>

  <!-- Les produits -->
  <section style="padding-top:clamp(24px,4vw,48px)">
    <div class="wrap">
      <ul class="sc">
        {
          p.items.map((it, n) => {
            const price = formatPrice(it.key as PriceKey, lang);
            const link = stripeLinks[it.key as 'diagnostic' | 'prompt'];
            return (
              <li class="sc-card reveal" tabindex="0">
                <div class={`sc-art t${n}`}>
                  <span class="sc-tag">{tag[it.key][lang]}</span>
                  <div class="sc-ic" set:html={icon[it.key]} />
                </div>
                <div class="sc-body">
                  <div class="sc-row"><h2>{it.name}</h2><b>{price.amount}</b></div>
                  <p class="sc-short">{short[it.key][lang]}</p>
                  <div class="sc-more">
                    <div>
                      <span class="sc-h">{p.forWhoLabel}</span>
                      <p>{it.forWho}</p>
                      <span class="sc-h">{p.getsLabel}</span>
                      <ul>{it.gets.map((g) => <li>{g.t}</li>)}</ul>
                      <div class="sc-cta">
                        <a class="btn btn-primary" href={href(lang, it.slug)}>{c.nav.more}</a>
                        <BuyButton product={it.key as 'diagnostic' | 'prompt'} lang={lang} label={it.cta} soon={p.soon} link={link} />
                      </div>
                    </div>
                  </div>
                </div>
              </li>
            );
          })
        }
      </ul>
    </div>
  </section>

  <!-- Comment ça marche -->
  <section style="background:var(--bg-2);border-block:1px solid var(--line)">
    <div class="wrap">
      <div class="section-head reveal">
        <span class="kicker">{p.how.kicker}</span>
        <h2>{p.how.title}</h2>
      </div>
      <div class="steps-line three reveal">
        {p.how.steps.map((s) => <div><b>{s.t}</b><span>{s.d}</span></div>)}
      </div>
    </div>
  </section>

  <!-- Ce que vous pouvez attendre -->
  <section>
    <div class="wrap">
      <div class="section-head reveal">
        <span class="kicker">{p.trustKicker}</span>
      </div>
      <div class="also reveal">
        {p.trust.map((it) => <div><b>{it.t}</b><span>{it.d}</span></div>)}
      </div>
    </div>
  </section>

  <!-- Et après ? -->
  <section style="padding-top:0">
    <div class="wrap split">
      <div class="reveal">
        <span class="kicker">{p.next.kicker}</span>
        <h2 set:html={em(p.next.title)} />
        <p class="lead">{p.next.text}</p>
        <div class="btn-row" style="margin-top:28px">
          <a class="btn btn-primary" href={href(lang, 'book')}>{p.next.linkCall}</a>
          <a class="btn btn-ghost" href={href(lang, 'offers')}>{p.next.linkOffers}</a>
        </div>
      </div>
      <div class="reveal soon-box">
        <span class="kicker">{p.formations.kicker}</span>
        <h3>{p.formations.title}</h3>
        <p>{p.formations.text}</p>
        <a class="textlink" href={`${href(lang)}#labo`}><span class="arrow">{p.formations.link}&nbsp;</span></a>
      </div>
    </div>
  </section>

  <CtaBand lang={lang} title={p.finalTitle} text={p.finalText} />
</Base>
