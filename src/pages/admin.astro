---
import '@fontsource-variable/archivo/wdth.css';
import { db, ensureSchema, hasDb } from '../lib/db';
import { adminConfigured, verifyToken } from '../lib/admin';
import { getAutoSend } from '../lib/settings';
import { env } from '../lib/env';

export const prerender = false;

Astro.response.headers.set('Cache-Control', 'no-store');
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');

if (Astro.url.searchParams.has('logout')) {
  Astro.cookies.delete('admin', { path: '/admin' });
  return Astro.redirect('/admin');
}

const configured = adminConfigured();
const authed = configured && verifyToken(Astro.cookies.get('admin')?.value);

let orders: Record<string, unknown>[] = [];
let dbError = '';
let autoSend = '1';

type Workflow = { id: string; name: string; active: boolean; updatedAt?: string };
type Execution = { id: string; workflowId: string; status?: string; finished?: boolean; startedAt?: string; stoppedAt?: string };
let n8n: { workflows: Workflow[]; executions: Execution[] } | null = null;
let n8nError = '';
const n8nBase = env('N8N_URL').replace(/\/$/, '');
const n8nConfigured = Boolean(n8nBase && env('N8N_API_KEY'));

if (authed && hasDb()) {
  try {
    await ensureSchema();
    const o = await db().query(
      `SELECT o.id, o.session_id, o.payment_intent, o.product, o.lang, o.email, o.name, o.amount, o.currency, o.status, o.refunded, o.created_at, o.paid_at,
              (a.order_id IS NOT NULL) AS has_answers, a.submitted_at, a.agent_status, a.agent_at, a.agent_attempts, a.agent_done_at, a.agent_mail_to,
              (a.result IS NOT NULL) AS has_result, a.client_sent_at, a.client_sent_to
         FROM orders o LEFT JOIN answers a ON a.order_id = o.id ORDER BY o.created_at DESC LIMIT 1000`,
    );
    orders = o.rows;
    autoSend = await getAutoSend();
  } catch (e) {
    const err = e as { code?: string; message?: string };
    dbError = [err.code, err.message].filter(Boolean).join(' : ').slice(0, 200);
    console.error('[admin] lecture de la base impossible :', e);
  }
}

if (authed && n8nConfigured) {
  try {
    const get = async (path: string) => {
      const res = await fetch(`${n8nBase}/api/v1${path}`, {
        headers: { 'X-N8N-API-KEY': env('N8N_API_KEY'), accept: 'application/json' },
        signal: AbortSignal.timeout(6000),
      });
      if (!res.ok) throw new Error(`n8n a répondu ${res.status}`);
      return (await res.json()) as { data: unknown[] };
    };
    const [w, x] = await Promise.all([get('/workflows?limit=100'), get('/executions?limit=25')]);
    n8n = { workflows: w.data as Workflow[], executions: x.data as Execution[] };
  } catch (e) {
    n8nError = ((e as Error).message || 'erreur inconnue').slice(0, 200);
    console.error('[admin] n8n injoignable :', e);
  }
}


const umami = (env('PUBLIC_UMAMI_URL') || (import.meta.env.PUBLIC_UMAMI_URL ?? '')).replace(/\/$/, '');
const boot = {
  orders,
  autoSend,
  n8n,
  n8nError,
  n8nConfigured,
  umami,
  hasDb: hasDb(),
  dbError,
  builtAt: Date.now(),
};
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Tableau de bord</title>
    <link rel="stylesheet" href="/admin/admin.css?v=1" />
  </head>
  <body>
    {!configured && (
      <main class="narrow">
        <h1>Tableau de bord</h1>
        <p class="muted">Non configuré : ajoutez la variable <code>ADMIN_PASSWORD</code> (12 caractères minimum) dans Coolify, puis redéployez.</p>
      </main>
    )}

    {configured && !authed && (
      <main class="narrow">
        <form class="login" id="login">
          <div class="brand-mark">Binta Kande</div>
          <h1>Connexion</h1>
          <p class="muted">Espace privé : suivi des commandes et des diagnostics.</p>
          <input type="password" id="pw" placeholder="Mot de passe" autocomplete="current-password" required />
          <p class="err" id="err" role="alert"></p>
          <button class="btn primary" type="submit">Entrer</button>
        </form>
      </main>
    )}

    {authed && (
      <div class="app" id="app">
        <aside class="side" id="side">
          <div class="side-top">
            <div class="brand-mark">Binta Kande</div>
            <div class="brand-sub">Tableau de bord</div>
          </div>
          <nav class="nav" id="nav" aria-label="Navigation">
            <a href="#overview" data-view="overview"><svg viewBox="0 0 24 24"><path d="M4 13h6V4H4v9Zm0 7h6v-5H4v5Zm10 0h6v-9h-6v9Zm0-16v5h6V4h-6Z"/></svg><span>Vue d’ensemble</span></a>
            <a href="#orders" data-view="orders"><svg viewBox="0 0 24 24"><path d="M3 5h18v2H3V5Zm0 6h18v2H3v-2Zm0 6h12v2H3v-2Z"/></svg><span>Commandes</span><b class="count" id="n-orders"></b></a>
            <a href="#delivery" data-view="delivery"><svg viewBox="0 0 24 24"><path d="M3 4h18v4H3V4Zm0 6h8v10H3V10Zm10 0h8v6h-8v-6Z"/></svg><span>Livraisons</span><b class="count warn" id="n-delivery"></b></a>
            <a href="#customers" data-view="customers"><svg viewBox="0 0 24 24"><path d="M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm0 2c-3.3 0-8 1.7-8 5v1h16v-1c0-3.3-4.7-5-8-5Z"/></svg><span>Clients</span></a>
            <a href="#automations" data-view="automations"><svg viewBox="0 0 24 24"><path d="M13 2 4 14h6l-1 8 9-12h-6l1-8Z"/></svg><span>Automatisations</span><b class="count bad" id="n-auto"></b></a>
          </nav>
          <div class="side-foot">
            {umami && <a class="foot-link" href={umami} target="_blank" rel="noopener noreferrer">Visites du site ↗</a>}
            <a class="foot-link" href="/admin?logout">Se déconnecter</a>
          </div>
        </aside>

        <div class="main">
          <header class="bar">
            <button class="burger" id="burger" aria-label="Menu"><svg viewBox="0 0 24 24"><path d="M3 6h18v2H3V6Zm0 5h18v2H3v-2Zm0 5h18v2H3v-2Z"/></svg></button>
            <h1 id="view-title">Vue d’ensemble</h1>
            <div class="bar-right">
              <div class="seg" id="period" role="tablist" aria-label="Période">
                <button data-p="7">7 j</button><button data-p="30" class="on">30 j</button><button data-p="90">90 j</button><button data-p="365">12 mois</button><button data-p="0">Tout</button>
              </div>
            </div>
          </header>

          {boot.dbError && <div class="banner bad">Impossible de lire la base de données ({boot.dbError}).</div>}
          {!boot.hasDb && <div class="banner">Base de données non configurée (<code>DATABASE_URL</code>).</div>}

          <main id="content">
            <section class="view" id="view-overview"></section>
            <section class="view" id="view-orders" hidden></section>
            <section class="view" id="view-delivery" hidden></section>
            <section class="view" id="view-customers" hidden></section>
            <section class="view" id="view-automations" hidden></section>
          </main>
        </div>

        <div class="scrim" id="scrim" hidden></div>
        <aside class="drawer" id="drawer" aria-hidden="true" aria-label="Détail de la commande"></aside>
        <div id="toasts" role="status"></div>
        <div class="modal" id="modal" hidden><div class="modal-card" id="modal-card"></div></div>
        <script type="application/json" id="boot" set:html={JSON.stringify(boot).replace(/</g, '\\u003c')} />
        <script is:inline src="/admin/app.js?v=1"></script>
      </div>
    )}

    {configured && !authed && (
      <script is:inline>
        document.getElementById('login').addEventListener('submit', async (e) => {
          e.preventDefault();
          const err = document.getElementById('err');
          err.textContent = '';
          const res = await fetch('/api/admin-login', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ password: document.getElementById('pw').value }) });
          if (res.ok) location.reload();
          else err.textContent = res.status === 429 ? 'Trop d’essais, réessayez dans 15 minutes.' : 'Mot de passe incorrect.';
        });
      </script>
    )}
  </body>
</html>
