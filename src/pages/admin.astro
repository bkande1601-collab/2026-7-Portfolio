---
import { db, ensureSchema, hasDb } from '../lib/db';
import { adminConfigured, verifyToken } from '../lib/admin';
import { money, productName, type Order } from '../lib/orders';
import { env } from '../lib/env';

export const prerender = false;

Astro.response.headers.set('Cache-Control', 'no-store');
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');

if (Astro.url.searchParams.has('logout')) {
  Astro.cookies.delete('admin', { path: '/admin' });
  return Astro.redirect('/admin');
}

const configured = adminConfigured();
const authed = configured && verifyToken(Astro.cookies.get('admin')?.value);

type Row = Order & { answers: { label: string; value: string }[] | null };
let orders: Row[] = [];
let stats = { paid: 0, revenue: 0, refunded: 0, pending: 0, expired: 0, last30: 0, last30Revenue: 0 };
let byProduct: { product: string; n: number; revenue: number }[] = [];
let dbError = false;

if (authed && hasDb()) {
  try {
    await ensureSchema();
    const o = await db().query<Row>(
      `SELECT o.*, a.data AS answers FROM orders o LEFT JOIN answers a ON a.order_id = o.id ORDER BY o.created_at DESC LIMIT 200`,
    );
    orders = o.rows;
    const s = await db().query(
      `SELECT
         count(*) FILTER (WHERE paid_at IS NOT NULL) AS paid,
         coalesce(sum(amount - refunded) FILTER (WHERE paid_at IS NOT NULL AND currency = 'eur'), 0) AS revenue,
         coalesce(sum(refunded) FILTER (WHERE currency = 'eur'), 0) AS refunded,
         count(*) FILTER (WHERE status = 'pending') AS pending,
         count(*) FILTER (WHERE status = 'expired') AS expired,
         count(*) FILTER (WHERE paid_at > now() - interval '30 days') AS last30,
         coalesce(sum(amount - refunded) FILTER (WHERE paid_at > now() - interval '30 days' AND currency = 'eur'), 0) AS last30_revenue
       FROM orders`,
    );
    const r = s.rows[0];
    stats = { paid: +r.paid, revenue: +r.revenue, refunded: +r.refunded, pending: +r.pending, expired: +r.expired, last30: +r.last30, last30Revenue: +r.last30_revenue };
    const p = await db().query(
      `SELECT product, count(*) AS n, coalesce(sum(amount - refunded), 0) AS revenue
       FROM orders WHERE paid_at IS NOT NULL AND currency = 'eur' GROUP BY product ORDER BY revenue DESC`,
    );
    byProduct = p.rows.map((x) => ({ product: x.product, n: +x.n, revenue: +x.revenue }));
  } catch {
    dbError = true;
  }
}

const eur = (c: number) => money(c, 'eur');
const fmt = (d: Date | null) =>
  d ? new Intl.DateTimeFormat('fr-FR', { dateStyle: 'short', timeStyle: 'short', timeZone: 'Europe/Paris' }).format(new Date(d)) : '';
const statusLabel: Record<string, string> = {
  pending: 'en attente', paid: 'payé', failed: 'échoué', expired: 'abandonné', refunded: 'remboursé', disputed: 'litige',
};
const umami = (env('PUBLIC_UMAMI_URL') || (import.meta.env.PUBLIC_UMAMI_URL ?? '')).replace(/\/$/, '');
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Tableau de bord</title>
    <style>
      :root { --bg:#f6f0e4; --card:#fffaf4; --ink:#1a1410; --muted:#7a6a5c; --line:#eadccc; --accent:#6b46c1; --ok:#1f7a4d; --bad:#b3372c; }
      @media (prefers-color-scheme: dark) { :root { --bg:#17120e; --card:#211a14; --ink:#f1e8de; --muted:#a8998a; --line:#3a2e24; --accent:#b79cf0; --ok:#5fd19a; --bad:#ff8f84; } }
      * { box-sizing: border-box; }
      body { margin:0; background:var(--bg); color:var(--ink); font:16px/1.5 system-ui, -apple-system, Helvetica, Arial, sans-serif; }
      main { max-width:1100px; margin:0 auto; padding:24px 16px 64px; }
      header { display:flex; justify-content:space-between; align-items:center; gap:12px; flex-wrap:wrap; margin-bottom:20px; }
      h1 { margin:0; font-size:1.6rem; letter-spacing:-.02em; }
      h2 { font-size:1.1rem; margin:28px 0 10px; }
      a { color:var(--accent); }
      .btn { display:inline-block; padding:9px 16px; border-radius:999px; border:1px solid var(--line); background:var(--card); color:var(--ink); text-decoration:none; font-size:.9rem; cursor:pointer; }
      .btn.primary { background:var(--accent); color:#fff; border-color:var(--accent); }
      .kpis { display:grid; grid-template-columns:repeat(auto-fit, minmax(160px, 1fr)); gap:12px; }
      .kpi { background:var(--card); border:1px solid var(--line); border-radius:14px; padding:14px 16px; }
      .kpi b { display:block; font-size:1.6rem; letter-spacing:-.02em; }
      .kpi span { color:var(--muted); font-size:.85rem; }
      .tablewrap { overflow-x:auto; background:var(--card); border:1px solid var(--line); border-radius:14px; }
      table { width:100%; border-collapse:collapse; font-size:.92rem; }
      th, td { text-align:left; padding:10px 12px; border-bottom:1px solid var(--line); vertical-align:top; white-space:nowrap; }
      th { color:var(--muted); font-weight:600; font-size:.8rem; text-transform:uppercase; letter-spacing:.04em; }
      tr:last-child td { border-bottom:0; }
      td.wrap { white-space:normal; }
      .tag { padding:2px 9px; border-radius:999px; font-size:.78rem; border:1px solid var(--line); }
      .tag.paid { color:var(--ok); border-color:var(--ok); }
      .tag.refunded, .tag.disputed, .tag.failed { color:var(--bad); border-color:var(--bad); }
      details summary { cursor:pointer; color:var(--accent); }
      dl { margin:8px 0 0; white-space:normal; }
      dt { font-weight:600; margin-top:8px; }
      dd { margin:2px 0 0; color:var(--muted); }
      form.login { max-width:340px; margin:12vh auto 0; background:var(--card); border:1px solid var(--line); border-radius:16px; padding:24px; display:grid; gap:12px; }
      input { padding:11px 14px; border-radius:10px; border:1px solid var(--line); background:var(--bg); color:var(--ink); font:inherit; }
      .err { color:var(--bad); min-height:1.2em; margin:0; font-size:.9rem; }
      .muted { color:var(--muted); }
    </style>
  </head>
  <body>
    <main>
      {!configured && (
        <>
          <h1>Tableau de bord</h1>
          <p class="muted">Non configuré : ajoutez la variable <code>ADMIN_PASSWORD</code> (12 caractères minimum) dans Coolify, puis redéployez.</p>
        </>
      )}

      {configured && !authed && (
        <form class="login" id="login">
          <h1>Connexion</h1>
          <input type="password" id="pw" placeholder="Mot de passe" autocomplete="current-password" required />
          <p class="err" id="err" role="alert"></p>
          <button class="btn primary" type="submit">Entrer</button>
        </form>
      )}

      {authed && (
        <>
          <header>
            <h1>Tableau de bord</h1>
            <div>
              {umami && <a class="btn" href={umami} target="_blank" rel="noopener noreferrer">Visites du site</a>}
              <a class="btn" href="/admin?logout">Se déconnecter</a>
            </div>
          </header>

          {!hasDb() && <p class="muted">Base de données non configurée (<code>DATABASE_URL</code>).</p>}
          {dbError && <p class="err">Impossible de lire la base de données.</p>}

          {hasDb() && !dbError && (
            <>
              <div class="kpis">
                <div class="kpi"><b>{eur(stats.revenue)}</b><span>Chiffre d’affaires net</span></div>
                <div class="kpi"><b>{stats.paid}</b><span>Commandes payées</span></div>
                <div class="kpi"><b>{eur(stats.last30Revenue)}</b><span>30 derniers jours ({stats.last30} commandes)</span></div>
                <div class="kpi"><b>{eur(stats.refunded)}</b><span>Remboursé</span></div>
                <div class="kpi"><b>{stats.pending}</b><span>Paiements en attente</span></div>
                <div class="kpi"><b>{stats.expired}</b><span>Paniers abandonnés</span></div>
              </div>

              <h2>Par produit</h2>
              <div class="tablewrap">
                <table>
                  <thead><tr><th>Produit</th><th>Commandes</th><th>Chiffre d’affaires</th></tr></thead>
                  <tbody>
                    {byProduct.length === 0 && <tr><td colspan="3" class="muted">Aucune vente pour l’instant.</td></tr>}
                    {byProduct.map((p) => <tr><td>{productName(p.product, 'fr')}</td><td>{p.n}</td><td>{eur(p.revenue)}</td></tr>)}
                  </tbody>
                </table>
              </div>

              <h2>Commandes</h2>
              <div class="tablewrap">
                <table>
                  <thead><tr><th>Date</th><th>Produit</th><th>Client</th><th>Montant</th><th>Statut</th><th>Réponses</th></tr></thead>
                  <tbody>
                    {orders.length === 0 && <tr><td colspan="6" class="muted">Aucune commande pour l’instant.</td></tr>}
                    {orders.map((o) => (
                      <tr>
                        <td>{fmt(o.paid_at ?? o.created_at)}</td>
                        <td>{productName(o.product, 'fr')}</td>
                        <td class="wrap">{o.name ?? ''}{o.name && o.email ? ' · ' : ''}{o.email ?? ''}</td>
                        <td>{o.amount ? money(o.amount, o.currency) : ''}{o.refunded ? ` (−${money(o.refunded, o.currency)})` : ''}</td>
                        <td><span class={`tag ${o.status}`}>{statusLabel[o.status] ?? o.status}</span></td>
                        <td class="wrap">
                          {o.answers ? (
                            <details>
                              <summary>Voir ({o.answers.length})</summary>
                              <dl>{o.answers.map((a) => (<><dt>{a.label}</dt><dd>{a.value}</dd></>))}</dl>
                            </details>
                          ) : (o.paid_at ? <span class="muted">pas encore</span> : '')}
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </>
          )}
        </>
      )}
    </main>

    <script is:inline>
      const form = document.getElementById('login');
      if (form) {
        form.addEventListener('submit', async (e) => {
          e.preventDefault();
          const err = document.getElementById('err');
          err.textContent = '';
          const res = await fetch('/api/admin-login', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ password: document.getElementById('pw').value }),
          });
          if (res.ok) location.reload();
          else err.textContent = res.status === 429 ? 'Trop d’essais, réessayez dans 15 minutes.' : 'Mot de passe incorrect.';
        });
      }
    </script>
  </body>
</html>
