---
import { site } from '../config/site';

interface Props {
  label: string;
  pending: string;
  soundOn: string;
  soundOff: string;
}
const { label, soundOn, soundOff } = Astro.props;
const hasVideo = Boolean(site.heroVideo);
---

<!--
  Tant que `heroVideo` est vide (src/config/site.ts), la photo s'affiche ici.
  Dès qu'une vidéo est renseignée, elle prend la place de la photo.
-->
<div class="video-slot" role={hasVideo ? 'img' : undefined} aria-label={hasVideo ? label : undefined}>
  {
    hasVideo ? (
      <video
        id="hero-video"
        src={site.heroVideo}
        poster={site.heroVideoPoster || site.heroPhoto || undefined}
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        aria-label={label}
      />
    ) : (
      <img src={site.heroPhoto} alt={site.heroPhotoAlt} width="800" height="840" fetchpriority="high" />
    )
  }
  {hasVideo && (
    <button class="sound-btn" id="sound-btn" type="button" aria-pressed="false" data-on={soundOn} data-off={soundOff}>
      <span aria-hidden="true">♪</span> <span id="sound-label">{soundOff}</span>
    </button>
  )}
</div>
{hasVideo && (
  <script>
    const v = document.getElementById('hero-video') as HTMLVideoElement | null;
    const b = document.getElementById('sound-btn') as HTMLButtonElement | null;
    const l = document.getElementById('sound-label');
    if (v && b && l) {
      b.addEventListener('click', () => {
        v.muted = !v.muted;
        if (!v.muted) v.play().catch(() => {});
        b.setAttribute('aria-pressed', String(!v.muted));
        l.textContent = v.muted ? b.dataset.off! : b.dataset.on!;
      });
    }
  </script>
)}
