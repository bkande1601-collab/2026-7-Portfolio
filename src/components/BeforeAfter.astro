---
/**
 * Avant / après : un cerveau en deux hémisphères.
 * À gauche, des neurones en désordre, des liens qui s'emmêlent, des signaux qui errent.
 * Au centre, une porte où tout se remet en ordre.
 * À droite, des neurones organisés en couches, avec des signaux qui circulent jusqu'à la sortie.
 * Les textes viennent de home.beforeAfter (fr.ts et en.ts).
 */
import { em } from '../content';

interface Props {
  data: {
    kicker: string;
    title: string;
    beforeLabel: string;
    afterLabel: string;
    before: string[];
    after: string[];
    caption: string;
  };
}
const { data } = Astro.props;

let seed = 23;
const rnd = () => (seed = (seed * 16807) % 2147483647) / 2147483647;
const f = (n: number) => Number(n.toFixed(1));
type Pt = { x: number; y: number };

// courbe lisse (Catmull-Rom vers Bézier)
function smooth(pts: Pt[], closed = false): string {
  const n = pts.length;
  const get = (i: number) => (closed ? pts[(i + n) % n] : pts[Math.min(n - 1, Math.max(0, i))]);
  let d = `M${f(pts[0].x)} ${f(pts[0].y)}`;
  const last = closed ? n : n - 1;
  for (let i = 0; i < last; i++) {
    const p0 = get(i - 1), p1 = get(i), p2 = get(i + 1), p3 = get(i + 2);
    d += ` C${f(p1.x + (p2.x - p0.x) / 6)} ${f(p1.y + (p2.y - p0.y) / 6)}, ${f(p2.x - (p3.x - p1.x) / 6)} ${f(p2.y - (p3.y - p1.y) / 6)}, ${f(p2.x)} ${f(p2.y)}`;
  }
  return closed ? d + 'Z' : d;
}

// contour d'un hémisphère : une ellipse « bosselée » comme les circonvolutions
function lobe(cx: number, cy: number, rx: number, ry: number, phase: number, flatSide: 1 | -1): Pt[] {
  const pts: Pt[] = [];
  for (let k = 0; k < 64; k++) {
    const a = (k / 64) * Math.PI * 2;
    const bump = 1 + 0.045 * Math.sin(8 * a + phase) + 0.025 * Math.sin(15 * a + phase * 2);
    let x = cx + Math.cos(a) * rx * bump;
    const y = cy + Math.sin(a) * ry * bump;
    // le côté tourné vers le centre est presque droit
    if (Math.cos(a) * flatSide > 0.78) x = cx + flatSide * rx * 0.99 * bump;
    pts.push({ x, y });
  }
  return pts;
}
const CY = 235;
const leftLobe = smooth(lobe(288, CY, 192, 168, 0.4, 1), true);
const rightLobe = smooth(lobe(712, CY, 192, 168, 1.9, -1), true);

// ---- gauche : neurones dispersés, liens emmêlés, plis tourmentés
const left: { x: number; y: number; r: number; d: number }[] = [];
let guard = 0;
while (left.length < 24 && guard++ < 6000) {
  const a = rnd() * Math.PI * 2;
  const r = Math.sqrt(rnd());
  const x = 288 + Math.cos(a) * r * 168;
  const y = CY + Math.sin(a) * r * 145;
  if (left.every((p) => Math.hypot(p.x - x, p.y - y) > 36)) left.push({ x: f(x), y: f(y), r: f(3.5 + rnd() * 4.5), d: f(rnd() * 3) });
}
const tangle = Array.from({ length: 40 }, () => {
  const i = Math.floor(rnd() * left.length);
  let j = Math.floor(rnd() * left.length);
  if (j === i) j = (j + 1) % left.length;
  const a = left[i], b = left[j];
  const cx = (a.x + b.x) / 2 + (rnd() - 0.5) * 190;
  const cy = (a.y + b.y) / 2 + (rnd() - 0.5) * 190;
  return { d: `M${a.x} ${a.y} Q${f(cx)} ${f(cy)} ${b.x} ${b.y}`, dur: f(1.3 + rnd() * 2.6), delay: f(rnd() * 2.5) };
});
const foldsL = Array.from({ length: 8 }, () => {
  let x = 288 + (rnd() - 0.5) * 260, y = CY + (rnd() - 0.5) * 240, a = rnd() * 6.28;
  const pts: Pt[] = [{ x, y }];
  for (let k = 0; k < 7; k++) { a += (rnd() - 0.5) * 2.6; x += Math.cos(a) * 46; y += Math.sin(a) * 46; pts.push({ x, y }); }
  return smooth(pts);
});
// signaux qui errent à gauche
const wander = tangle.slice(0, 9).map((t, i) => ({ id: `w${i}`, d: t.d, begin: f(i * 0.45), dur: f(2 + (i % 4) * 0.5) }));

// ---- droite : couches de neurones reliées, plis fluides et parallèles
const cols = [{ x: 566, n: 3 }, { x: 650, n: 5 }, { x: 734, n: 5 }, { x: 818, n: 3 }];
const layers = cols.map((c) => Array.from({ length: c.n }, (_, k) => ({ x: c.x, y: f(CY + (k - (c.n - 1) / 2) * 56) })));
const links: { id: string; d: string }[] = [];
for (let l = 0; l < layers.length - 1; l++)
  layers[l].forEach((a, i) => layers[l + 1].forEach((b, j) => links.push({ id: `l${l}-${i}-${j}`, d: `M${a.x} ${a.y} L${b.x} ${b.y}` })));
const pulses = links.filter((_, i) => i % 3 === 0).map((l, i) => ({ ...l, begin: f((i * 0.31) % 2.4), dur: f(1.3 + ((i * 7) % 5) * 0.18) }));
const foldsR = Array.from({ length: 8 }, (_, k) => {
  const y0 = CY - 135 + k * 38;
  const pts: Pt[] = [];
  for (let s = 0; s <= 8; s++) { const x = 535 + s * 38; pts.push({ x, y: y0 + Math.sin(s * 0.8 + k * 0.5) * 11 }); }
  return smooth(pts);
});

// ---- le passage au centre : les signaux se mettent en file
const GATE = { x: 500, y: CY };
const inputs = layers[0];
const streams = [
  { id: 's0', d: `M392 ${CY - 70} C 440 ${CY - 70}, 460 ${CY}, ${GATE.x} ${GATE.y} S 540 ${inputs[0].y}, ${inputs[0].x} ${inputs[0].y}`, begin: 0 },
  { id: 's1', d: `M380 ${CY} C 430 ${CY + 6}, 462 ${CY}, ${GATE.x} ${GATE.y} S 540 ${inputs[1].y}, ${inputs[1].x} ${inputs[1].y}`, begin: 0.7 },
  { id: 's2', d: `M392 ${CY + 70} C 440 ${CY + 70}, 460 ${CY}, ${GATE.x} ${GATE.y} S 540 ${inputs[2].y}, ${inputs[2].x} ${inputs[2].y}`, begin: 1.4 },
];

const label = `${data.beforeLabel} : ${data.before.join(', ')}. ${data.afterLabel} : ${data.after.join(', ')}.`;
---

<div class="section-head reveal">
  <span class="kicker">{data.kicker}</span>
  <h2 set:html={em(data.title)} />
</div>

<figure class="brain reveal">
  <svg viewBox="0 0 1000 520" role="img" aria-label={label} focusable="false">
    <defs>
      <filter id="glow" x="-50%" y="-50%" width="200%" height="200%">
        <feGaussianBlur stdDeviation="4" result="b" />
        <feMerge><feMergeNode in="b" /><feMergeNode in="SourceGraphic" /></feMerge>
      </filter>
      <radialGradient id="gl" cx="50%" cy="45%" r="60%"><stop offset="0%" stop-color="#d08a5a" stop-opacity="0.22" /><stop offset="100%" stop-color="#d08a5a" stop-opacity="0.02" /></radialGradient>
      <radialGradient id="gr" cx="50%" cy="45%" r="60%"><stop offset="0%" stop-color="#c6b8e4" stop-opacity="0.3" /><stop offset="100%" stop-color="#694cac" stop-opacity="0.05" /></radialGradient>
      <pattern id="dots" width="28" height="28" patternUnits="userSpaceOnUse"><circle cx="2" cy="2" r="1.2" fill="rgba(246,240,228,0.09)" /></pattern>
      <clipPath id="clipL"><path d={leftLobe} /></clipPath>
      <clipPath id="clipR"><path d={rightLobe} /></clipPath>
    </defs>

    <rect width="1000" height="520" fill="url(#dots)" />

    <!-- les deux hémisphères -->
    <path class="lobe lobe-l" d={leftLobe} fill="url(#gl)" />
    <path class="lobe lobe-r" d={rightLobe} fill="url(#gr)" />
    <g clip-path="url(#clipL)">{foldsL.map((d) => <path class="fold fold-l" d={d} />)}</g>
    <g clip-path="url(#clipR)">{foldsR.map((d) => <path class="fold fold-r" d={d} />)}</g>

    <!-- avant : le désordre -->
    <g class="chaos" clip-path="url(#clipL)">
      {tangle.map((t) => <path class="tangle" d={t.d} style={`animation-duration:${t.dur}s;animation-delay:${t.delay}s`} />)}
      {left.map((n) => <circle class="nb" cx={n.x} cy={n.y} r={n.r} style={`animation-delay:${n.d}s`} />)}
    </g>
    {wander.map((w) => <path id={w.id} d={w.d} fill="none" stroke="none" />)}
    {
      wander.map((w) => (
        <circle class="wander" r="3.5">
          <animateMotion dur={`${w.dur}s`} begin={`${w.begin}s`} repeatCount="indefinite"><mpath href={`#${w.id}`} /></animateMotion>
        </circle>
      ))
    }

    <!-- la porte : tout se met en ordre -->
    {streams.map((s) => <path id={s.id} d={s.d} class="stream" />)}
    <circle class="gate-halo" cx={GATE.x} cy={GATE.y} r="30" />
    <circle class="gate" cx={GATE.x} cy={GATE.y} r="11" filter="url(#glow)" />
    {
      streams.map((s) => (
        <circle class="sig" r="5" filter="url(#glow)">
          <animateMotion dur="2.4s" begin={`${s.begin}s`} repeatCount="indefinite"><mpath href={`#${s.id}`} /></animateMotion>
        </circle>
      ))
    }

    <!-- après : le réseau organisé -->
    <g class="order" clip-path="url(#clipR)">
      {links.map((l) => <path id={l.id} class="link" d={l.d} />)}
      {
        pulses.map((p) => (
          <circle r="4" class="pulse-dot" filter="url(#glow)">
            <animateMotion dur={`${p.dur}s`} begin={`${p.begin}s`} repeatCount="indefinite"><mpath href={`#${p.id}`} /></animateMotion>
          </circle>
        ))
      }
      {layers.flat().map((n, i) => <circle class="na" cx={n.x} cy={n.y} r="7" filter="url(#glow)" style={`animation-delay:${(i % 6) * 0.3}s`} />)}
      {layers[layers.length - 1].map((n, i) => <circle class="out-ring" cx={n.x} cy={n.y} r="15" style={`animation-delay:${i * 0.5}s`} />)}
    </g>

    <g class="tag tag-l"><rect x="208" y="468" width="160" height="38" rx="19" /><text x="288" y="493" text-anchor="middle">{data.beforeLabel}</text></g>
    <g class="tag tag-r"><rect x="632" y="468" width="160" height="38" rx="19" /><text x="712" y="493" text-anchor="middle">{data.afterLabel}</text></g>
  </svg>

  <div class="ba-lists">
    <ul class="ba-l">{data.before.map((x) => <li>{x}</li>)}</ul>
    <ul class="ba-r">{data.after.map((x) => <li>{x}</li>)}</ul>
  </div>
  <figcaption class="ba-caption">{data.caption}</figcaption>
</figure>

<script>
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.querySelectorAll<SVGSVGElement>('.brain svg').forEach((s) => s.pauseAnimations());
  }
</script>
