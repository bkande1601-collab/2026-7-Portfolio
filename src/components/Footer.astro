---
import { t, href, type Lang } from '../content';
import { site } from '../config/site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = t(lang);
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap foot">
    <p>© {year} {site.name}. {c.footer.rights}</p>
    <div class="foot-links">
      <a href={href(lang, 'faq')}>{c.nav.faq}</a>
      <button class="foot-btn" id="welcome-on" type="button">{c.footer.welcomeOn}</button>
      <a href={href(lang, 'contact')}>{c.cta.message}</a>
      {site.links.github && <a href={site.links.github} rel="noopener noreferrer" target="_blank">{c.footer.github}</a>}
      {site.links.linkedin && <a href={site.links.linkedin} rel="noopener noreferrer" target="_blank">{c.footer.linkedin}</a>}
    </div>
  </div>
</footer>

<script>
  document.getElementById('welcome-on')?.addEventListener('click', () => {
    try {
      localStorage.removeItem('welcome-sound');
      sessionStorage.removeItem('welcome-played');
    } catch {
      /* ignore */
    }
    location.reload();
  });
</script>
