---
import { t, href, em, type Lang } from '../content';
import CtaMenu from './CtaMenu.astro';

interface Props {
  lang: Lang;
  title: string;
  text?: string;
}
const { lang, title, text } = Astro.props;
const c = t(lang);
---

<section class="cta-band">
  <div class="wrap cta-inner">
    <div class="reveal">
      <h2 set:html={em(title)} />
      {text && <p>{text}</p>}
    </div>
    <div class="btn-row reveal">
      <CtaMenu lang={lang} />
    </div>
  </div>
</section>
