---
/**
 * Vidéo motion design sans voix, avec un bouton pour activer la petite musique.
 * Elle démarre en silence (les navigateurs bloquent le son automatique).
 */
interface Props {
  src: string;
  poster?: string;
  label: string;
  soundOn: string;
  soundOff: string;
  pauseLabel?: string;
  playLabel?: string;
}
const { src, poster, label, soundOn, soundOff, pauseLabel = 'Pause', playLabel = 'Play' } = Astro.props;
---

<div class="motion">
  <video src={src} poster={poster} autoplay muted loop playsinline preload="metadata" aria-label={label}></video>
  <div class="motion-bar">
    <button class="sound-btn motion-pause" type="button" data-pause={pauseLabel} data-play={playLabel}>{pauseLabel}</button>
    <button class="sound-btn motion-sound" type="button" aria-pressed="false" data-on={soundOn} data-off={soundOff}>
      <span aria-hidden="true">♪</span> <span class="motion-label">{soundOff}</span>
    </button>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('.motion').forEach((box) => {
    const v = box.querySelector('video');
    const b = box.querySelector<HTMLButtonElement>('.motion-sound');
    const l = box.querySelector('.motion-label');
    const pz = box.querySelector<HTMLButtonElement>('.motion-pause');
    if (pz && v) {
      const sync = () => { pz.textContent = v.paused ? pz.dataset.play! : pz.dataset.pause!; };
      const toggle = () => { if (v.paused) v.play().catch(() => {}); else v.pause(); };
      pz.addEventListener('click', toggle);
      v.addEventListener('click', toggle);
      v.addEventListener('play', sync);
      v.addEventListener('pause', sync);
      v.style.cursor = 'pointer';
      sync();
    }
    if (!v || !b || !l) return;
    b.addEventListener('click', () => {
      v.muted = !v.muted;
      v.volume = 0.35;
      if (!v.muted) v.play().catch(() => {});
      b.setAttribute('aria-pressed', String(!v.muted));
      l.textContent = v.muted ? b.dataset.off! : b.dataset.on!;
    });
  });
</script>
