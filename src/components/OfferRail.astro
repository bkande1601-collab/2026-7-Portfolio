---
/** Les offres sur une seule ligne (accueil). */
import { t, href, type Lang } from '../content';
import { formatPrice as fmt, type PriceKey } from '../config/site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = t(lang);

const stops: { key: PriceKey; name: string; page: string }[] = [
  { key: 'diagnostic', name: c.offers.ladder[0].name, page: 'products' },
  { key: 'prompt', name: c.offers.ladder[1].name, page: 'products' },
  { key: 'clarity', name: c.offers.ladder[2].name, page: 'book' },
  { key: 'agent', name: c.offers.ladder[3].name, page: 'automations' },
  { key: 'system', name: c.offers.ladder[4].name, page: 'automations' },
  { key: 'run', name: 'Run', page: 'offers' },
];
---

<div class="rail-wrap" tabindex="0" role="region" aria-label={c.home.offersTitle}>
  <div class="rail">
    {
      stops.map((s) => {
        const p = fmt(s.key, lang);
        return (
          <a class="stop" href={href(lang, s.page)}>
            <span class="f">{p.from ? c.offers.from : p.range ? ' ' : s.key === 'run' ? ' ' : c.offers.flat}</span>
            <span class="p">
              {p.amount}
              {p.per === 'month' && <small>{c.offers.perMonth}</small>}
            </span>
            <span class="n">{s.name}</span>
          </a>
        );
      })
    }
  </div>
</div>
