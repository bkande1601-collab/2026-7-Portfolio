---
import { t, href, type Lang } from '../content';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = t(lang);
const k = c.chat;
---

<div class="site-chat" id="chat" data-lang={lang} data-error={k.error} data-thinking={k.thinking} data-preview={k.preview}>
  <button class="chat-open" id="chat-open" type="button" aria-expanded="false" aria-controls="chat-panel">
    <span class="chat-dot" aria-hidden="true"></span>{k.open}
  </button>

  <div class="chat-panel" id="chat-panel" role="dialog" aria-label={k.title} hidden>
    <div class="chat-head">
      <b>{k.title}</b>
      <button class="chat-x" id="chat-close" type="button" aria-label={k.close}>×</button>
    </div>
    <div class="chat-log" id="chat-log" aria-live="polite">
      <p class="msg bot">{k.hello}</p>
    </div>
    <div class="chat-chips" id="chat-chips">
      {k.chips.map((x) => <button type="button" class="chip">{x}</button>)}
    </div>
    <form class="chat-form" id="chat-form" autocomplete="off">
      <input class="hp" type="text" name="website" tabindex="-1" aria-hidden="true" autocomplete="off" />
      <label class="sr-only" for="chat-input">{k.placeholder}</label>
      <input id="chat-input" name="message" type="text" maxlength="500" placeholder={k.placeholder} required />
      <button class="btn btn-primary btn-sm" type="submit">{k.send}</button>
    </form>
    <p class="chat-note">{k.note} <a href={href(lang, 'book')}>{c.cta.book}</a></p>
  </div>
</div>

<script>
  const root = document.getElementById('chat');
  if (root) {
    const lang = root.dataset.lang || 'fr';
    const openBtn = document.getElementById('chat-open') as HTMLButtonElement;
    const closeBtn = document.getElementById('chat-close') as HTMLButtonElement;
    const panel = document.getElementById('chat-panel') as HTMLElement;
    const log = document.getElementById('chat-log') as HTMLElement;
    const form = document.getElementById('chat-form') as HTMLFormElement;
    const input = document.getElementById('chat-input') as HTMLInputElement;
    const chips = document.getElementById('chat-chips') as HTMLElement;
    const history: { role: 'user' | 'assistant'; content: string }[] = [];

    const set = (open: boolean) => {
      panel.hidden = !open;
      openBtn.setAttribute('aria-expanded', String(open));
      if (open) input.focus();
      else openBtn.focus();
    };
    openBtn.addEventListener('click', () => set(panel.hidden));
    closeBtn.addEventListener('click', () => set(false));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !panel.hidden) set(false);
    });

    const add = (text: string, who: 'bot' | 'me') => {
      const p = document.createElement('p');
      p.className = `msg ${who}`;
      p.textContent = text; // jamais d'HTML : on affiche du texte
      log.appendChild(p);
      log.scrollTop = log.scrollHeight;
      return p;
    };

    const ask = async (text: string) => {
      chips.hidden = true;
      add(text, 'me');
      const wait = add(root.dataset.thinking || '…', 'bot');
      wait.classList.add('wait');
      try {
        const res = await fetch('/api/chat', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ message: text, lang, history, website: (form.elements.namedItem('website') as HTMLInputElement).value }),
        });
        const data = await res.json();
        if (!res.ok || !data.reply) throw new Error('x');
        wait.classList.remove('wait');
        wait.textContent = data.reply;
        history.push({ role: 'user', content: text }, { role: 'assistant', content: data.reply });
      } catch {
        wait.classList.remove('wait');
        wait.textContent = root.dataset.error || '';
      }
      log.scrollTop = log.scrollHeight;
    };

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const v = input.value.trim();
      if (!v) return;
      input.value = '';
      ask(v);
    });
    chips.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest('.chip');
      if (b) ask(b.textContent || '');
    });
  }
</script>
